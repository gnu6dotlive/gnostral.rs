diff --git a/mistralrs-core/src/moe/experts/residency.rs b/mistralrs-core/src/moe/experts/residency.rs
new file mode 100644
index 000000000..2baaef6c3
--- /dev/null
+++ b/mistralrs-core/src/moe/experts/residency.rs
@@ -0,0 +1,575 @@
+//! Opt-in native expert residency. Configuration is read once per Qwen3 model.
+use super::residency_observation::{ResidencyCounters, ResidencyObservation};
+use candle_core::Result;
+use gnostral_expert_residency::ExpertKey;
+use serde::Deserialize;
+use std::collections::BTreeSet;
+use std::time::Instant;
+
+pub(crate) struct ExpertResidencyConfig {
+    pub budget_bytes: u64,
+    pub profile: Vec<ExpertKey>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Profile {
+    schema: u32,
+    model_sha256: String,
+    layers: u32,
+    experts_per_layer: u32,
+    ranking: Vec<RankedExpert>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RankedExpert {
+    layer: u32,
+    expert: u32,
+}
+
+impl ExpertResidencyConfig {
+    pub(super) fn from_values(
+        budget: Option<&str>,
+        profile: Option<&str>,
+        model_sha256: &str,
+        layers: u32,
+        experts: u32,
+    ) -> Result<Option<Self>> {
+        let Some(budget) = budget else {
+            if profile.is_some() {
+                candle_core::bail!("expert profile requires GNOSTRAL_EXPERT_CACHE_BYTES");
+            }
+            return Ok(None);
+        };
+        if budget.is_empty() || !budget.bytes().all(|b| b.is_ascii_digit()) {
+            candle_core::bail!("GNOSTRAL_EXPERT_CACHE_BYTES must be decimal bytes");
+        }
+        let budget_bytes = budget
+            .parse::<u64>()
+            .map_err(|e| candle_core::Error::Msg(e.to_string()))?;
+        if budget_bytes == 0 {
+            return Ok(None);
+        }
+        let text = profile.ok_or_else(|| {
+            candle_core::Error::Msg("nonzero expert cache requires GNOSTRAL_EXPERT_PROFILE".into())
+        })?;
+        let profile: Profile = serde_json::from_str(text)
+            .map_err(|e| candle_core::Error::Msg(format!("invalid expert profile: {e}")))?;
+        if profile.schema != 1
+            || profile.model_sha256.len() != 64
+            || !profile
+                .model_sha256
+                .bytes()
+                .all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase())
+            || profile.model_sha256 != model_sha256
+            || profile.layers != layers
+            || profile.experts_per_layer != experts
+            || layers == 0
+            || experts == 0
+        {
+            candle_core::bail!("expert profile schema, model hash or geometry mismatch");
+        }
+        let mut seen = BTreeSet::new();
+        let mut ranking = Vec::new();
+        for e in profile.ranking {
+            let key = ExpertKey {
+                layer: e.layer,
+                expert: e.expert,
+            };
+            if key.layer >= layers || key.expert >= experts || !seen.insert(key) {
+                candle_core::bail!("expert profile contains invalid or duplicate ranking entries");
+            }
+            ranking.push(key);
+        }
+        Ok(Some(Self {
+            budget_bytes,
+            profile: ranking,
+        }))
+    }
+}
+
+use candle_core::{
+    quantized::{GgmlDType, QMatMul, QTensor},
+    DType, Device, Module, Tensor,
+};
+use gnostral_expert_residency::{partition_routes, CachePlan, ExpertSize, ResidencyTable, Route};
+use std::{
+    collections::BTreeMap,
+    sync::{Arc, Mutex, MutexGuard},
+};
+
+#[derive(Clone)]
+pub(super) struct ExpertProjectionSet {
+    pub gate: Arc<QTensor>,
+    pub up: Arc<QTensor>,
+    pub down: Arc<QTensor>,
+}
+impl ExpertProjectionSet {
+    fn tensors(&self) -> [&Arc<QTensor>; 3] {
+        [&self.gate, &self.up, &self.down]
+    }
+    fn slice_to(&self, expert: usize, device: &Device) -> Result<Self> {
+        Ok(Self {
+            gate: Arc::new(self.gate.expert_slice_to(expert, device)?),
+            up: Arc::new(self.up.expert_slice_to(expert, device)?),
+            down: Arc::new(self.down.expert_slice_to(expert, device)?),
+        })
+    }
+    fn compute(
+        &self,
+        xs: &Tensor,
+        activation: &impl Fn(&Tensor) -> Result<Tensor>,
+    ) -> Result<Tensor> {
+        let gate = QMatMul::from_arc(self.gate.clone())?.forward(xs)?;
+        let up = QMatMul::from_arc(self.up.clone())?.forward(xs)?;
+        QMatMul::from_arc(self.down.clone())?.forward(&(activation(&gate)? * up)?)
+    }
+    fn padded_bytes(&self, experts: u32) -> Result<u64> {
+        let mut bytes = 0u64;
+        for q in self.tensors() {
+            // Exact formula in pinned Candle load_quantized. Verify against each owned slice.
+            let logical = q.storage_size_in_bytes() as u64 / u64::from(experts);
+            let padding = 512u64
+                .checked_mul(q.dtype().type_size() as u64)
+                .ok_or_else(|| error("padding overflow"))?
+                / q.dtype().block_size() as u64;
+            bytes = bytes
+                .checked_add(logical)
+                .and_then(|n| n.checked_add(padding))
+                .ok_or_else(|| error("allocation byte sum overflow"))?;
+        }
+        Ok(bytes)
+    }
+    fn allocation_bytes(&self) -> Result<u64> {
+        self.tensors().iter().try_fold(0u64, |sum, q| {
+            sum.checked_add(
+                q.cuda_allocation_bytes()
+                    .ok_or_else(|| error("CUDA allocation accounting unavailable"))?,
+            )
+            .ok_or_else(|| error("allocation byte sum overflow"))
+        })
+    }
+}
+fn error(message: &str) -> candle_core::Error {
+    candle_core::Error::Msg(message.into())
+}
+fn residency_error(e: gnostral_expert_residency::ResidencyError) -> candle_core::Error {
+    candle_core::Error::Msg(e.to_string())
+}
+
+struct RuntimeState {
+    host: BTreeMap<u32, ExpertProjectionSet>,
+    // Only GPU-mapped layers can acquire CUDA cache slots. CPU-mapped layers
+    // remain quantized on host and execute on CPU, never via PCIe uploads.
+    cpu_layers: BTreeSet<u32>,
+    resident: BTreeMap<ExpertKey, ExpertProjectionSet>,
+    table: Option<ResidencyTable>,
+    allocated_bytes: u64,
+    observation: ResidencyCounters,
+    released: bool,
+}
+/// Model-scoped owner; one admission plan and one byte budget across every layer.
+pub(crate) struct ExpertResidencyRuntime {
+    config: ExpertResidencyConfig,
+    layers: u32,
+    experts: u32,
+    device: Device,
+    state: Mutex<RuntimeState>,
+}
+impl ExpertResidencyRuntime {
+    pub(crate) fn new(
+        config: ExpertResidencyConfig,
+        layers: u32,
+        experts: u32,
+        device: Device,
+    ) -> Result<Self> {
+        if layers == 0 || experts == 0 {
+            candle_core::bail!("empty expert residency geometry");
+        }
+        Ok(Self {
+            config,
+            layers,
+            experts,
+            device,
+            state: Mutex::new(RuntimeState {
+                host: BTreeMap::new(),
+                cpu_layers: BTreeSet::new(),
+                resident: BTreeMap::new(),
+                table: None,
+                allocated_bytes: 0,
+                observation: ResidencyCounters::default(),
+                released: false,
+            }),
+        })
+    }
+    pub(super) fn require_device(&self, device: &Device) -> Result<()> {
+        if !(device.is_cpu() || device.same_device(&self.device)) {
+            candle_core::bail!(
+                "expert residency supports CPU layers or the one pinned CUDA device"
+            );
+        }
+        Ok(())
+    }
+    fn state(&self) -> Result<MutexGuard<'_, RuntimeState>> {
+        self.state
+            .lock()
+            .map_err(|_| error("expert residency state poisoned"))
+    }
+    #[cfg(test)]
+    pub(super) fn register(&self, layer: u32, weights: ExpertProjectionSet) -> Result<()> {
+        self.register_on(layer, weights, &self.device)
+    }
+    pub(super) fn register_on(
+        &self,
+        layer: u32,
+        weights: ExpertProjectionSet,
+        layer_device: &Device,
+    ) -> Result<()> {
+        self.require_device(layer_device)?;
+        if layer >= self.layers {
+            candle_core::bail!("expert layer out of range");
+        }
+        let (e, n, k) = weights.gate.shape().dims3()?;
+        if e != self.experts as usize
+            || n == 0
+            || k == 0
+            || weights.up.shape() != weights.gate.shape()
+            || weights.down.shape().dims() != [e, k, n]
+        {
+            candle_core::bail!("expert gate/up/down geometry mismatch");
+        }
+        for q in weights.tensors() {
+            if !q.device().is_cpu()
+                || !matches!(
+                    q.dtype(),
+                    GgmlDType::Q2K
+                        | GgmlDType::Q3K
+                        | GgmlDType::Q4K
+                        | GgmlDType::Q5K
+                        | GgmlDType::Q6K
+                        | GgmlDType::Q4_0
+                        | GgmlDType::Q4_1
+                        | GgmlDType::Q5_0
+                        | GgmlDType::Q5_1
+                        | GgmlDType::Q8_0
+                )
+            {
+                candle_core::bail!("residency requires untransformed CPU GGUF quantized stacks");
+            }
+            let dims = q.shape().dims();
+            let expected = dims[0]
+                .checked_mul(dims[1])
+                .and_then(|n| n.checked_mul(dims[2] / q.dtype().block_size()))
+                .and_then(|n| n.checked_mul(q.dtype().type_size()))
+                .ok_or_else(|| error("expert packed byte size overflow"))?;
+            if expected != q.storage_size_in_bytes() {
+                candle_core::bail!("expert packed byte size does not match geometry");
+            }
+            if q.shape().dims()[2] % q.dtype().block_size() != 0
+                || q.storage_size_in_bytes() % e != 0
+            {
+                candle_core::bail!("expert stack is not block-aligned");
+            }
+        }
+        let mut state = self.state()?;
+        if state.table.is_some() || state.host.contains_key(&layer) {
+            candle_core::bail!("expert layer already registered or loading already finished");
+        }
+        if state.released {
+            candle_core::bail!("expert residency is already released");
+        }
+        let logical_bytes = weights.tensors().iter().try_fold(0u64, |sum, q| {
+            sum.checked_add(q.storage_size_in_bytes() as u64)
+                .ok_or_else(|| error("host quantized weight byte counter overflow"))
+        })?;
+        state.observation.host_bytes(logical_bytes)?;
+        if layer_device.is_cpu() {
+            state.cpu_layers.insert(layer);
+        }
+        state.host.insert(layer, weights);
+        Ok(())
+    }
+    pub(crate) fn finish_loading(&self) -> Result<()> {
+        let mut state = self.state()?;
+        if state.released || state.table.is_some() || state.host.len() != self.layers as usize {
+            candle_core::bail!("expert layers incomplete or already initialized");
+        }
+        let mut sizes = Vec::new();
+        for (&layer, weights) in &state.host {
+            let bytes = weights.padded_bytes(self.experts)?;
+            for expert in 0..self.experts {
+                sizes.push(ExpertSize {
+                    key: ExpertKey { layer, expert },
+                    bytes,
+                });
+            }
+        }
+        // The complete profile is validated at ingress. Only the ranking
+        // of GPU-mapped layers participates in CUDA admission; CPU layers
+        // can never consume budget or accidentally be uploaded.
+        let admitted_profile = self
+            .config
+            .profile
+            .iter()
+            .copied()
+            .filter(|key| !state.cpu_layers.contains(&key.layer))
+            .collect::<Vec<_>>();
+        tracing::info!(
+            cpu_layers = state.cpu_layers.len(),
+            gpu_layers = self.layers as usize - state.cpu_layers.len(),
+            excluded_cpu_profile_entries = self.config.profile.len() - admitted_profile.len(),
+            "native expert residency mixed-device admission"
+        );
+        let plan = CachePlan::build(
+            self.layers,
+            self.experts,
+            &sizes,
+            &admitted_profile,
+            self.config.budget_bytes,
+        )
+        .map_err(residency_error)?;
+        let slots = plan.slots().to_vec();
+        let mut table = ResidencyTable::new(plan);
+        let mut resident = BTreeMap::new();
+        let mut allocated_bytes = 0u64;
+        for slot in slots {
+            if !self.device.is_cuda() {
+                candle_core::bail!("resident expert slots require CUDA");
+            }
+            let ticket = table.begin_upload(slot.key).map_err(residency_error)?;
+            state.observation.begin_upload(slot.bytes)?;
+            let start = Instant::now();
+            let upload = (|| {
+                let tensors =
+                    state.host[&slot.key.layer].slice_to(slot.key.expert as usize, &self.device)?;
+                self.device.synchronize()?;
+                let bytes = tensors.allocation_bytes()?;
+                if bytes != slot.bytes {
+                    candle_core::bail!(
+                        "actual expert allocation differs from planned padded bytes"
+                    );
+                }
+                Ok((tensors, bytes))
+            })();
+            match upload {
+                Ok((tensors, bytes)) => {
+                    table
+                        .complete_upload(ticket, true)
+                        .map_err(residency_error)?;
+                    allocated_bytes = allocated_bytes
+                        .checked_add(bytes)
+                        .ok_or_else(|| error("resident allocation overflow"))?;
+                    resident.insert(slot.key, tensors);
+                    state.observation.complete_upload(bytes, start.elapsed())?;
+                }
+                Err(e) => {
+                    let _ = table.complete_upload(ticket, false);
+                    state.observation.failed_upload()?;
+                    return Err(e);
+                }
+            }
+        }
+        state.table = Some(table);
+        state.resident = resident;
+        state.allocated_bytes = allocated_bytes;
+        let receipt = state.observation.snapshot(
+            Some(state.allocated_bytes),
+            state
+                .table
+                .as_ref()
+                .map_or(0, ResidencyTable::active_leases),
+            false,
+        );
+        tracing::info!(gpu_allocated_bytes = ?receipt.gpu_allocated_bytes,
+            host_weight_logical_bytes = ?receipt.cpu_weight_bytes,
+            upload_bytes = receipt.upload_bytes, upload_ms = ?receipt.upload_ms,
+            "native expert residency engine counters initialized");
+        Ok(())
+    }
+    pub(crate) fn snapshot(&self) -> Result<ResidencyObservation> {
+        let state = self.state()?;
+        Ok(state.observation.snapshot(
+            state.table.as_ref().map(|_| state.allocated_bytes),
+            state
+                .table
+                .as_ref()
+                .map_or(0, ResidencyTable::active_leases),
+            state.released,
+        ))
+    }
+    /// Engine-owned drain. A driver sync error never generates a false reclaim receipt.
+    pub(crate) fn drain_and_release(&self) -> Result<()> {
+        let mut state = self.state()?;
+        if state.released {
+            return Ok(());
+        }
+        if let Some(table) = state.table.as_ref() {
+            if table.active_leases() != 0 {
+                candle_core::bail!("cannot drain expert residency with outstanding leases");
+            }
+        }
+        // Hold all projection Arcs until synchronization confirms owned CUDA work finished.
+        self.device.synchronize()?;
+        if let Some(table) = state.table.as_mut() {
+            table.close().map_err(residency_error)?;
+        }
+        state.resident.clear();
+        state.host.clear();
+        state.cpu_layers.clear();
+        state.allocated_bytes = 0;
+        state.observation.cpu_weight_bytes = 0;
+        state.released = true;
+        Ok(())
+    }
+    pub(super) fn allocated_bytes(&self) -> Result<u64> {
+        Ok(self.state()?.allocated_bytes)
+    }
+    pub(super) fn is_resident(&self, key: ExpertKey) -> Result<bool> {
+        Ok(self.state()?.resident.contains_key(&key))
+    }
+    pub(super) fn forward(
+        &self,
+        layer: u32,
+        xs: &Tensor,
+        routes: &[Route],
+        activation: impl Fn(&Tensor) -> Result<Tensor>,
+    ) -> Result<Tensor> {
+        let (tokens, hidden) = xs.dims2()?;
+        let mut state = self.state()?;
+        let host = state
+            .host
+            .get(&layer)
+            .ok_or_else(|| error("expert layer unavailable"))?
+            .clone();
+        if hidden != host.gate.shape().dims()[2] {
+            candle_core::bail!("expert input dimension mismatch");
+        }
+        if routes
+            .iter()
+            .any(|r| r.key.layer != layer || r.token >= tokens)
+        {
+            candle_core::bail!("route token or layer out of range");
+        }
+        let is_cpu_layer = state.cpu_layers.contains(&layer);
+        let table = state
+            .table
+            .as_mut()
+            .ok_or_else(|| error("expert loading not finished"))?;
+        table
+            .validate_key(ExpertKey { layer, expert: 0 })
+            .map_err(residency_error)?;
+        let partition = partition_routes(table, routes).map_err(residency_error)?;
+        if is_cpu_layer && !partition.gpu.is_empty() {
+            candle_core::bail!("CPU-mapped layer unexpectedly owns CUDA expert leases");
+        }
+        state
+            .observation
+            .route(partition.gpu.len(), partition.cpu.len())?;
+        let mut ordered = routes.to_vec();
+        ordered.sort_by_key(|r| (r.token, r.ordinal));
+        let compute = (|| {
+            let cpu = xs.to_dtype(DType::F32)?.to_device(&Device::Cpu)?;
+            let mut output = vec![
+                0f32;
+                tokens
+                    .checked_mul(hidden)
+                    .ok_or_else(|| error("output shape overflow"))?
+            ];
+            for route in ordered {
+                let row = cpu.narrow(0, route.token, 1)?;
+                let contribution = if let Some(weights) = state.resident.get(&route.key) {
+                    weights
+                        .compute(&row.to_device(&self.device)?, &activation)?
+                        .to_device(&Device::Cpu)?
+                } else {
+                    host.slice_to(route.key.expert as usize, &Device::Cpu)?
+                        .compute(&row, &activation)?
+                };
+                let values = contribution.to_vec2::<f32>()?;
+                for (dst, &value) in output[route.token * hidden..(route.token + 1) * hidden]
+                    .iter_mut()
+                    .zip(&values[0])
+                {
+                    *dst += value * route.weight;
+                }
+            }
+            Tensor::from_vec(output, (tokens, hidden), xs.device())?.to_dtype(xs.dtype())
+        })();
+        // Errors may occur after enqueue. Never release a pin before owned CUDA work completes.
+        if !partition.gpu.is_empty() {
+            self.device.synchronize()?;
+        }
+        let table = state
+            .table
+            .as_mut()
+            .expect("table retained throughout forward");
+        for (_, lease) in partition.gpu {
+            table.release(lease).map_err(residency_error)?;
+        }
+        compute
+    }
+}
+
+impl Drop for ExpertResidencyRuntime {
+    fn drop(&mut self) {
+        match self.drain_and_release() {
+            Ok(()) => {
+                // Engine-owned allocation release is not a host-observed VRAM reclaim receipt.
+                tracing::debug!(
+                    "native expert residency references released after synchronization"
+                );
+            }
+            Err(error) => {
+                // Drop cannot preserve allocations after a driver failure; do not claim reclaim.
+                tracing::error!(%error, "native expert residency unload unqualified");
+            }
+        }
+    }
+}
+
+pub(crate) struct ExpertResidencyRequest {
+    budget: String,
+    profile: String,
+}
+impl ExpertResidencyRequest {
+    pub(crate) fn from_environment() -> Result<Option<Self>> {
+        let read = |name| match std::env::var(name) {
+            Ok(value) => Ok(Some(value)),
+            Err(std::env::VarError::NotPresent) => Ok(None),
+            Err(e) => Err(error(&format!("invalid {name}: {e}"))),
+        };
+        let budget = read("GNOSTRAL_EXPERT_CACHE_BYTES")?;
+        let profile_path = read("GNOSTRAL_EXPERT_PROFILE")?;
+        let Some(budget) = budget else {
+            if profile_path.is_some() {
+                candle_core::bail!("expert profile requires cache budget");
+            }
+            return Ok(None);
+        };
+        if budget.is_empty() || !budget.bytes().all(|b| b.is_ascii_digit()) {
+            candle_core::bail!("expert cache budget must be decimal bytes");
+        }
+        let bytes = budget.parse::<u64>().map_err(|e| error(&e.to_string()))?;
+        if bytes == 0 {
+            return Ok(None);
+        }
+        let path = profile_path.ok_or_else(|| error("expert cache requires profile path"))?;
+        let profile = std::fs::read_to_string(path)
+            .map_err(|e| error(&format!("cannot read expert profile: {e}")))?;
+        Ok(Some(Self { budget, profile }))
+    }
+    pub(crate) fn validate(
+        self,
+        hash: &str,
+        layers: u32,
+        experts: u32,
+    ) -> Result<ExpertResidencyConfig> {
+        ExpertResidencyConfig::from_values(
+            Some(&self.budget),
+            Some(&self.profile),
+            hash,
+            layers,
+            experts,
+        )?
+        .ok_or_else(|| error("unexpected disabled expert residency request"))
+    }
+}
