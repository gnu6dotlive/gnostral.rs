new file mode 100644
index 000000000..3846621ee
--- /dev/null
+++ b/mistralrs-core/src/moe/experts/residency_observation.rs
@@ -0,0 +1,111 @@
+//! Engine-owned observation: never external placement or eviction authority.
+//! GPU: padded bytes of owned CUDA allocations; CPU: logical mapped GGUF bytes.
+use candle_core::{Error, Result};
+use std::time::Duration;
+
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) struct ResidencyObservation {
+    pub gpu_allocated_bytes: Option<u64>,
+    pub cpu_weight_bytes: Option<u64>,
+    pub routing_hits: u64,
+    pub routing_misses: u64,
+    pub upload_attempted_bytes: u64,
+    pub upload_bytes: u64,
+    pub failed_uploads: u64,
+    pub upload_ms: Option<f64>,
+    pub active_leases: usize,
+    pub released: bool,
+}
+
+#[derive(Default)]
+pub(super) struct ResidencyCounters {
+    pub cpu_weight_bytes: u64,
+    pub routing_hits: u64,
+    pub routing_misses: u64,
+    pub upload_attempted_bytes: u64,
+    pub upload_bytes: u64,
+    pub failed_uploads: u64,
+    pub upload_duration: Option<Duration>,
+}
+impl ResidencyCounters {
+    fn add(v: &mut u64, amount: u64) -> Result<()> {
+        *v = v
+            .checked_add(amount)
+            .ok_or_else(|| Error::Msg("expert residency counter overflow".into()))?;
+        Ok(())
+    }
+    pub fn host_bytes(&mut self, bytes: u64) -> Result<()> {
+        Self::add(&mut self.cpu_weight_bytes, bytes)
+    }
+    pub fn begin_upload(&mut self, planned_bytes: u64) -> Result<()> {
+        Self::add(&mut self.upload_attempted_bytes, planned_bytes)
+    }
+    pub fn complete_upload(&mut self, actual_bytes: u64, elapsed: Duration) -> Result<()> {
+        Self::add(&mut self.upload_bytes, actual_bytes)?;
+        self.upload_duration = Some(
+            self.upload_duration
+                .unwrap_or_default()
+                .saturating_add(elapsed),
+        );
+        Ok(())
+    }
+    pub fn failed_upload(&mut self) -> Result<()> {
+        Self::add(&mut self.failed_uploads, 1)
+    }
+    pub fn route(&mut self, gpu: usize, cpu: usize) -> Result<()> {
+        Self::add(&mut self.routing_hits, gpu as u64)?;
+        Self::add(&mut self.routing_misses, cpu as u64)
+    }
+    pub fn snapshot(
+        &self,
+        gpu: Option<u64>,
+        leases: usize,
+        released: bool,
+    ) -> ResidencyObservation {
+        ResidencyObservation {
+            gpu_allocated_bytes: gpu,
+            cpu_weight_bytes: Some(self.cpu_weight_bytes),
+            routing_hits: self.routing_hits,
+            routing_misses: self.routing_misses,
+            upload_attempted_bytes: self.upload_attempted_bytes,
+            upload_bytes: self.upload_bytes,
+            failed_uploads: self.failed_uploads,
+            upload_ms: self.upload_duration.map(|v| v.as_secs_f64() * 1000.0),
+            active_leases: leases,
+            released,
+        }
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn missing_timing_is_unknown_not_zero() {
+        let s = ResidencyCounters::default().snapshot(None, 0, false);
+        assert_eq!(s.upload_ms, None);
+        assert_eq!(s.gpu_allocated_bytes, None);
+    }
+    #[test]
+    fn failed_upload_never_increments_completed_bytes() -> Result<()> {
+        let mut c = ResidencyCounters::default();
+        c.begin_upload(8192)?;
+        c.failed_upload()?;
+        let s = c.snapshot(Some(0), 0, false);
+        assert_eq!(s.upload_attempted_bytes, 8192);
+        assert_eq!(s.upload_bytes, 0);
+        assert_eq!(s.failed_uploads, 1);
+        Ok(())
+    }
+    #[test]
+    fn completed_transfer_and_routes_are_distinct() -> Result<()> {
+        let mut c = ResidencyCounters::default();
+        c.begin_upload(4096)?;
+        c.complete_upload(4096, Duration::from_millis(2))?;
+        c.route(2, 3)?;
+        let s = c.snapshot(Some(4096), 1, false);
+        assert_eq!((s.routing_hits, s.routing_misses), (2, 3));
+        assert_eq!(s.upload_ms, Some(2.0));
+        assert_eq!(s.active_leases, 1);
+        Ok(())
+    }
+}
diff --git a/mistralrs-core/src/moe/experts/residency_tests.rs b/mistralrs-core/src/moe/experts/residency_tests.rs
