+        if forward.topk_ids.dims() != [forward.shape.num_tokens, config.num_experts_per_tok]
+            || forward.topk_weights.dims() != forward.topk_ids.dims()
+        {
+            candle_core::bail!("expert route tensor geometry mismatch");
+        }
+        let ids = forward.topk_ids.to_device(&Device::Cpu)?.to_vec2::<u32>()?;
+        let weights = forward
+            .topk_weights
+            .to_dtype(DType::F32)?
+            .to_device(&Device::Cpu)?
+            .to_vec2::<f32>()?;
+        let mut routes = Vec::new();
+        for (token, (ids, weights)) in ids.iter().zip(&weights).enumerate() {
+            for (ordinal, (&expert, &weight)) in ids.iter().zip(weights).enumerate() {
+                routes.push(gnostral_expert_residency::Route {
+                    token,
+                    ordinal,
+                    key: gnostral_expert_residency::ExpertKey {
+                        layer: self.layer_id,
+                        expert,
+                    },
+                    weight,
+                });
+            }
+        }
+        self.cache
+            .forward(self.layer_id, forward.xs_flat, &routes, |xs| {
+                xs.apply(&config.act)
+            })
+    }
+}
