@@ -0,0 +1,384 @@
+use super::residency::ExpertResidencyConfig;
+
+const HASH: &str = "db3ce897ccc9e7d9dbf17fe083cae7880a2092aa473b45eba8b77715aa9ca170";
+fn profile() -> String {
+    format!(
+        r#"{{"schema":1,"model_sha256":"{HASH}","layers":2,"experts_per_layer":3,"ranking":[{{"layer":1,"expert":2}},{{"layer":0,"expert":1}}]}}"#
+    )
+}
+#[test]
+fn absent_or_zero_cache_preserves_original_dispatch() {
+    assert!(ExpertResidencyConfig::from_values(None, None, HASH, 2, 3)
+        .unwrap()
+        .is_none());
+    assert!(
+        ExpertResidencyConfig::from_values(Some("0"), None, HASH, 2, 3)
+            .unwrap()
+            .is_none()
+    );
+}
+#[test]
+fn profile_identity_and_geometry_are_validated() {
+    let p = profile();
+    let cfg = ExpertResidencyConfig::from_values(Some("1024"), Some(&p), HASH, 2, 3)
+        .unwrap()
+        .unwrap();
+    assert_eq!(cfg.budget_bytes, 1024);
+    assert_eq!(cfg.profile[0].layer, 1);
+    assert_eq!(cfg.profile[0].expert, 2);
+    assert!(ExpertResidencyConfig::from_values(Some("1024"), Some(&p), "wrong", 2, 3).is_err());
+    assert!(ExpertResidencyConfig::from_values(Some("1024"), Some(&p), HASH, 3, 3).is_err());
+}
+#[test]
+fn malformed_or_incomplete_opt_in_is_an_error() {
+    for budget in ["-1", "1GB", "18446744073709551616", ""] {
+        assert!(
+            ExpertResidencyConfig::from_values(Some(budget), Some(&profile()), HASH, 2, 3).is_err()
+        );
+    }
+    for p in [
+        "{}",
+        "invalid",
+        &profile().replace("\"schema\":1", "\"schema\":2"),
+        &profile().replace("\"expert\":2", "\"expert\":3"),
+        &profile().replace("{\"layer\":0,\"expert\":1}", "{\"layer\":1,\"expert\":2}"),
+    ] {
+        assert!(ExpertResidencyConfig::from_values(Some("1024"), Some(p), HASH, 2, 3).is_err());
+    }
+    assert!(ExpertResidencyConfig::from_values(Some("1024"), None, HASH, 2, 3).is_err());
+    assert!(ExpertResidencyConfig::from_values(None, Some(&profile()), HASH, 2, 3).is_err());
+}
+
+use super::residency::{ExpertProjectionSet, ExpertResidencyRuntime};
+use candle_core::{
+    quantized::{GgmlDType, QTensor},
+    DType, Device, Module, Tensor,
+};
+use gnostral_expert_residency::{ExpertKey, Route};
+use std::sync::Arc;
+fn projections() -> candle_core::Result<ExpertProjectionSet> {
+    let values = (0..3 * 256 * 256)
+        .map(|i| (1.0 + (i % 7) as f32) / 4096.0)
+        .collect::<Vec<_>>();
+    let q = Arc::new(QTensor::quantize(
+        &Tensor::from_vec(values, (3, 256, 256), &Device::Cpu)?,
+        GgmlDType::Q2K,
+    )?);
+    let down = Arc::new(QTensor::quantize(
+        &Tensor::ones((3, 256, 256), DType::F32, &Device::Cpu)?.affine(1.0 / 4096.0, 0.0)?,
+        GgmlDType::Q3K,
+    )?);
+    Ok(ExpertProjectionSet {
+        gate: q.clone(),
+        up: q,
+        down,
+    })
+}
+fn routes() -> Vec<Route> {
+    vec![
+        Route {
+            token: 0,
+            ordinal: 0,
+            key: ExpertKey {
+                layer: 0,
+                expert: 1,
+            },
+            weight: 0.4,
+        },
+        Route {
+            token: 0,
+            ordinal: 1,
+            key: ExpertKey {
+                layer: 0,
+                expert: 1,
+            },
+            weight: 0.6,
+        },
+        Route {
+            token: 1,
+            ordinal: 0,
+            key: ExpertKey {
+                layer: 0,
+                expert: 0,
+            },
+            weight: 1.0,
+        },
+    ]
+}
+#[test]
+fn cpu_routes_preserve_repeated_contributions_and_order() -> candle_core::Result<()> {
+    let runtime = ExpertResidencyRuntime::new(
+        ExpertResidencyConfig {
+            budget_bytes: 0,
+            profile: vec![],
+        },
+        1,
+        3,
+        Device::Cpu,
+    )?;
+    runtime.register(0, projections()?)?;
+    runtime.finish_loading()?;
+    let xs = Tensor::ones((2, 256), DType::F32, &Device::Cpu)?;
+    let mut reversed = routes();
+    reversed.reverse();
+    let a = runtime
+        .forward(0, &xs, &routes(), |x| x.silu())?
+        .to_vec2::<f32>()?;
+    let b = runtime
+        .forward(0, &xs, &reversed, |x| x.silu())?
+        .to_vec2::<f32>()?;
+    assert_eq!(a, b);
+    let host = projections()?;
+    let row = xs.narrow(0, 0, 1)?;
+    let gate =
+        candle_core::quantized::QMatMul::from_qtensor(host.gate.expert_slice_to(1, &Device::Cpu)?)?
+            .forward(&row)?;
+    let up =
+        candle_core::quantized::QMatMul::from_qtensor(host.up.expert_slice_to(1, &Device::Cpu)?)?
+            .forward(&row)?;
+    let expected =
+        candle_core::quantized::QMatMul::from_qtensor(host.down.expert_slice_to(1, &Device::Cpu)?)?
+            .forward(&(gate.silu()? * up)?)?
+            .to_vec2::<f32>()?;
+    for (a, b) in a[0].iter().zip(&expected[0]) {
+        assert!((a - b).abs() <= 1e-6);
+    }
+    assert!(runtime
+        .forward(
+            0,
+            &xs,
+            &[Route {
+                token: 0,
+                ordinal: 0,
+                key: ExpertKey {
+                    layer: 0,
+                    expert: 3
+                },
+                weight: 1.0
+            }],
+            |x| Ok(x.clone())
+        )
+        .is_err());
+    Ok(())
+}
+#[cfg(feature = "cuda")]
+#[test]
+fn model_global_budget_and_mixed_gpu_routes_match_cpu() -> candle_core::Result<()> {
+    let device = Device::new_cuda(0)?;
+    let one_expert = ((256 * 256 / 256 + 512 / 256)
+        * (2 * GgmlDType::Q2K.type_size() + GgmlDType::Q3K.type_size()))
+        as u64;
+    let ranking = vec![
+        ExpertKey {
+            layer: 0,
+            expert: 1,
+        },
+        ExpertKey {
+            layer: 1,
+            expert: 2,
+        },
+    ];
+    let gpu = ExpertResidencyRuntime::new(
+        ExpertResidencyConfig {
+            budget_bytes: one_expert,
+            profile: ranking,
+        },
+        2,
+        3,
+        device.clone(),
+    )?;
+    let cpu = ExpertResidencyRuntime::new(
+        ExpertResidencyConfig {
+            budget_bytes: 0,
+            profile: vec![],
+        },
+        2,
+        3,
+        Device::Cpu,
+    )?;
+    for layer in 0..2 {
+        gpu.register(layer, projections()?)?;
+        cpu.register(layer, projections()?)?;
+    }
+    gpu.finish_loading()?;
+    cpu.finish_loading()?;
+    assert_eq!(gpu.allocated_bytes()?, one_expert);
+    assert!(gpu.is_resident(ExpertKey {
+        layer: 0,
+        expert: 1
+    })?);
+    assert!(!gpu.is_resident(ExpertKey {
+        layer: 1,
+        expert: 2
+    })?);
+    let xs = Tensor::ones((2, 256), DType::F32, &Device::Cpu)?;
+    let reference = cpu
+        .forward(0, &xs, &routes(), |x| x.silu())?
+        .to_vec2::<f32>()?;
+    let candidate = gpu
+        .forward(0, &xs.to_device(&device)?, &routes(), |x| x.silu())?
+        .to_device(&Device::Cpu)?
+        .to_vec2::<f32>()?;
+    for (a, b) in candidate.iter().flatten().zip(reference.iter().flatten()) {
+        assert!(a.is_finite());
+        assert!((a - b).abs() <= 1e-4 + 1e-3 * b.abs());
+    }
+    Ok(())
+}
+
+#[test]
+fn loading_is_transactional_and_rejects_incomplete_layers() -> candle_core::Result<()> {
+    let runtime = ExpertResidencyRuntime::new(
+        ExpertResidencyConfig {
+            budget_bytes: 0,
+            profile: vec![],
+        },
+        2,
+        3,
+        Device::Cpu,
+    )?;
+    runtime.register(0, projections()?)?;
+    assert!(runtime.register(0, projections()?).is_err());
+    assert!(runtime.finish_loading().is_err());
+    assert_eq!(runtime.allocated_bytes()?, 0);
+    runtime.register(1, projections()?)?;
+    runtime.finish_loading()?;
+    assert!(runtime.finish_loading().is_err());
+    assert!(runtime.register(1, projections()?).is_err());
+    Ok(())
+}
+
+#[test]
+fn owned_residency_observation_and_double_drain_cpu() -> candle_core::Result<()> {
+    let runtime = ExpertResidencyRuntime::new(
+        ExpertResidencyConfig {
+            budget_bytes: 0,
+            profile: vec![],
+        },
+        1,
+        3,
+        Device::Cpu,
+    )?;
+    assert_eq!(runtime.snapshot()?.gpu_allocated_bytes, None);
+    runtime.register(0, projections()?)?;
+    runtime.finish_loading()?;
+    let ready = runtime.snapshot()?;
+    assert_eq!(ready.gpu_allocated_bytes, Some(0));
+    assert!(ready.cpu_weight_bytes.unwrap() > 0);
+    assert!(ready.upload_ms.is_none());
+    let xs = Tensor::ones((2, 256), DType::F32, &Device::Cpu)?;
+    runtime.forward(0, &xs, &routes(), |x| x.silu())?;
+    let report = runtime.snapshot()?;
+    assert_eq!(report.routing_hits, 0);
+    assert_eq!(report.routing_misses, routes().len() as u64);
+    assert_eq!(report.active_leases, 0);
+    runtime.drain_and_release()?;
+    runtime.drain_and_release()?; // idempotent
+    let stopped = runtime.snapshot()?;
+    assert!(stopped.released);
+    assert_eq!(stopped.gpu_allocated_bytes, Some(0));
+    assert_eq!(stopped.cpu_weight_bytes, Some(0));
+    assert!(runtime.forward(0, &xs, &routes(), |x| x.silu()).is_err());
+    Ok(())
+}
+
+#[cfg(feature = "cuda")]
+#[test]
+fn observed_gpu_allocations_are_completed_uploads() -> candle_core::Result<()> {
+    let device = Device::new_cuda(0)?;
+    let one = ((256 * 256 / 256 + 512 / 256)
+        * (2 * GgmlDType::Q2K.type_size() + GgmlDType::Q3K.type_size())) as u64;
+    let runtime = ExpertResidencyRuntime::new(
+        ExpertResidencyConfig {
+            budget_bytes: one,
+            profile: vec![ExpertKey {
+                layer: 0,
+                expert: 0,
+            }],
+        },
+        1,
+        3,
+        device.clone(),
+    )?;
+    runtime.register(0, projections()?)?;
+    runtime.finish_loading()?;
+    let observation = runtime.snapshot()?;
+    assert_eq!(observation.gpu_allocated_bytes, Some(one));
+    assert_eq!(observation.upload_bytes, one);
+    assert_eq!(observation.upload_attempted_bytes, one);
+    assert!(observation.upload_ms.unwrap().is_finite());
+    let xs = Tensor::ones((2, 256), DType::F32, &device)?;
+    runtime.forward(0, &xs, &routes(), |x| x.silu())?;
+    let observation = runtime.snapshot()?;
+    assert_eq!(observation.routing_hits, 1);
+    assert_eq!(observation.routing_misses, 2);
+    runtime.drain_and_release()?;
+    assert_eq!(runtime.snapshot()?.gpu_allocated_bytes, Some(0));
+    Ok(())
+}
+
+#[cfg(feature = "cuda")]
+#[test]
+fn mixed_cpu_cuda_layer_admission_never_uploads_cpu_only_experts() -> candle_core::Result<()> {
+    let cuda = Device::new_cuda(0)?;
+    let expert_bytes = ((256 * 256 / 256 + 512 / 256)
+        * (2 * GgmlDType::Q2K.type_size() + GgmlDType::Q3K.type_size()))
+        as u64;
+    let cpu_rank = ExpertKey {
+        layer: 1,
+        expert: 2,
+    };
+    let gpu_rank = ExpertKey {
+        layer: 0,
+        expert: 1,
+    };
+    let runtime = ExpertResidencyRuntime::new(
+        ExpertResidencyConfig {
+            budget_bytes: expert_bytes,
+            profile: vec![cpu_rank, gpu_rank],
+        },
+        2,
+        3,
+        cuda.clone(),
+    )?;
+    runtime.register_on(0, projections()?, &cuda)?;
+    runtime.register_on(1, projections()?, &Device::Cpu)?;
+    runtime.finish_loading()?;
+    assert_eq!(runtime.allocated_bytes()?, expert_bytes);
+    assert!(!runtime.is_resident(cpu_rank)?);
+    assert!(runtime.is_resident(gpu_rank)?);
+    let cpu_input = Tensor::ones((2, 256), DType::F32, &Device::Cpu)?;
+    let routed = routes()
+        .into_iter()
+        .map(|mut r| {
+            r.key.layer = 1;
+            r
+        })
+        .collect::<Vec<_>>();
+    let reference = ExpertResidencyRuntime::new(
+        ExpertResidencyConfig {
+            budget_bytes: 0,
+            profile: vec![],
+        },
+        2,
+        3,
+        Device::Cpu,
+    )?;
+    reference.register(0, projections()?)?;
+    reference.register(1, projections()?)?;
+    reference.finish_loading()?;
+    let expected = reference
+        .forward(1, &cpu_input, &routed, |x| x.silu())?
+        .to_vec2::<f32>()?;
+    let actual = runtime
+        .forward(1, &cpu_input, &routed, |x| x.silu())?
+        .to_vec2::<f32>()?;
+    assert_eq!(actual, expected);
+    let observation = runtime.snapshot()?;
+    assert_eq!(observation.routing_hits, 0);
+    assert_eq!(observation.routing_misses, routed.len() as u64);
+    assert_eq!(observation.gpu_allocated_bytes, Some(expert_bytes));
+    runtime.drain_and_release()?;
+    assert_eq!(runtime.snapshot()?.gpu_allocated_bytes, Some(0));
+    Ok(())
+}
