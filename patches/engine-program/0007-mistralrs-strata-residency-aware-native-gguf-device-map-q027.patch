From 99a0735d73bc7fee94724843337d959a2a686bbb Mon Sep 17 00:00:00 2001
From: Jordan <dev.in@gnu6.live>
Date: Sat, 24 Oct 2026 14:53:12 +0000
Subject: [PATCH] fix(device-map): residency-aware sizing on the native GGUF
 path (Qwen3MoELoader)

0006 fixed GgufDeviceMapLoaderInner, which only the legacy adapter path uses.
GgufModelBuilder loads through load_native_normal, whose automatic device map
sizes layers with Qwen3MoELoader (PreparedWeightSource sizing). Under expert
residency those layer sizes now drop the expert stacks and the cache budget is
reserved once in the non-mapped size.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016D4Xz7aLLGu873oZNF6vk4
---
 .../src/pipeline/loaders/normal_loaders.rs    | 71 ++++++++++++++++++-
 1 file changed, 69 insertions(+), 2 deletions(-)

diff --git a/mistralrs-core/src/pipeline/loaders/normal_loaders.rs b/mistralrs-core/src/pipeline/loaders/normal_loaders.rs
index 647156e..b7151f6 100644
--- a/mistralrs-core/src/pipeline/loaders/normal_loaders.rs
+++ b/mistralrs-core/src/pipeline/loaders/normal_loaders.rs
@@ -4871,6 +4871,15 @@ impl IsqModelLoader for Qwen3MoELoader {
     }
 }
 
+/// Expert cache bytes when Qwen3 MoE expert residency is requested, else 0.
+fn qwen3_moe_residency_cache_bytes() -> usize {
+    #[cfg(feature = "gnostral-expert-residency")]
+    if let Some(bytes) = crate::moe::requested_cache_bytes() {
+        return usize::try_from(bytes).unwrap_or(usize::MAX);
+    }
+    0
+}
+
 impl DeviceMappedModelLoader for Qwen3MoELoader {
     fn mapped_max_act_size_elems(
         &self,
@@ -4929,7 +4938,7 @@ impl DeviceMappedModelLoader for Qwen3MoELoader {
             let norm = cfg.hidden_size;
             embed_tokens + lm_head + norm
         };
-        Ok(elems * dtype.size_in_bytes())
+        Ok(elems * dtype.size_in_bytes() + qwen3_moe_residency_cache_bytes())
     }
 
     fn layer_sizes_in_bytes(
@@ -4966,7 +4975,13 @@ impl DeviceMappedModelLoader for Qwen3MoELoader {
                     let down_proj = i_size * h_size / weight_pack_factor;
                     gate_proj + up_proj + down_proj
                 };
-                expert_size * cfg.num_experts + gate_size
+                // Under expert residency the stacks load host-side; the device holds only the
+                // cache budget, reserved once in the non-mapped size.
+                if qwen3_moe_residency_cache_bytes() > 0 {
+                    gate_size
+                } else {
+                    expert_size * cfg.num_experts + gate_size
+                }
             } else {
                 let h_size = cfg.hidden_size;
                 let i_size = cfg.intermediate_size;
@@ -7333,3 +7348,55 @@ mod tests {
         assert_eq!(mxfp4, vec![1816]);
     }
 }
+
+#[cfg(all(test, feature = "gnostral-expert-residency"))]
+mod qwen3_moe_residency_sizing_tests {
+    use super::*;
+
+    const CACHE_ENV: &str = "GNOSTRAL_EXPERT_CACHE_BYTES";
+
+    #[test]
+    fn residency_drops_expert_stacks_from_native_gguf_layer_sizes() -> Result<()> {
+        // Qwen3-30B-A3B geometry.
+        let cfg = models::qwen3_moe::Config {
+            vocab_size: 151_936,
+            hidden_size: 2048,
+            intermediate_size: 6144,
+            num_hidden_layers: 48,
+            num_attention_heads: 32,
+            num_key_value_heads: 4,
+            head_dim: Some(128),
+            moe_intermediate_size: 768,
+            num_experts: 128,
+            decoder_sparse_step: 1,
+            num_experts_per_tok: 8,
+            max_position_embeddings: 4096,
+            ..Default::default()
+        };
+        let config = serde_json::to_string(&cfg)?;
+        let loader = Qwen3MoELoader;
+        let sizes = || -> Result<(Vec<usize>, usize)> {
+            Ok((
+                loader.layer_sizes_in_bytes(&config, DType::BF16, 1, None)?,
+                loader.non_mapped_size_in_bytes(&config, DType::BF16, 1, None, None)?,
+            ))
+        };
+        // No other test in this crate reads this variable.
+        std::env::remove_var(CACHE_ENV);
+        let (dense, dense_rest) = sizes()?;
+        std::env::set_var(CACHE_ENV, "4096");
+        let resident = sizes();
+        std::env::remove_var(CACHE_ENV);
+        let (res, res_rest) = resident?;
+
+        let stacks = 128 * 3 * 2048 * 768 * DType::BF16.size_in_bytes();
+        assert_eq!(dense.len(), 48);
+        for (d, r) in dense.iter().zip(&res) {
+            assert_eq!(d - r, stacks);
+        }
+        assert_eq!(res_rest, dense_rest + 4096);
+        // Without the stacks all 48 layers together stay far below an 8 GiB card.
+        assert!(res.iter().sum::<usize>() < 2 << 30);
+        Ok(())
+    }
+}
