diff --git a/mistralrs-core/src/moe/experts/residency_tests.rs b/mistralrs-core/src/moe/experts/residency_tests.rs
index d0464ed..3c3e1f5 100644
--- a/mistralrs-core/src/moe/experts/residency_tests.rs
+++ b/mistralrs-core/src/moe/experts/residency_tests.rs
@@ -549,3 +549,47 @@ fn executor_configuration_is_explicit() -> candle_core::Result<()> {
     assert!(ExecutorConfig::from_values(Some("per-route"), Some("gnostral"), None).is_err());
     Ok(())
 }
+
+#[test]
+fn recorded_demand_is_a_loadable_profile_ranked_by_routes() -> candle_core::Result<()> {
+    let dir = std::env::temp_dir().join(format!("gnostral-profile-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).map_err(candle_core::Error::wrap)?;
+    let path = dir.join("profile.json");
+    let runtime = ExpertResidencyRuntime::new(
+        ExpertResidencyConfig {
+            budget_bytes: 0,
+            profile: vec![],
+        },
+        1,
+        3,
+        Device::Cpu,
+    )?
+    .with_profile_out(path.clone(), HASH.to_string());
+    runtime.register(0, projections()?)?;
+    runtime.finish_loading()?;
+    let xs = Tensor::ones((2, 256), DType::F32, &Device::Cpu)?;
+    // routes(): expert 1 twice, expert 0 once.
+    runtime.forward(0, &xs, &routes(), |x| x.silu())?;
+    runtime.drain_and_release()?;
+    let text = std::fs::read_to_string(&path).map_err(candle_core::Error::wrap)?;
+    let loaded = ExpertResidencyConfig::from_values(Some("1"), Some(&text), HASH, 1, 3)?
+        .expect("nonzero budget");
+    assert_eq!(
+        loaded.profile,
+        vec![
+            ExpertKey {
+                layer: 0,
+                expert: 1
+            },
+            ExpertKey {
+                layer: 0,
+                expert: 0
+            }
+        ]
+    );
+    let demand = std::fs::read_to_string(path.with_extension("demand.json"))
+        .map_err(candle_core::Error::wrap)?;
+    assert!(demand.contains("\"routes\":2"));
+    let _ = std::fs::remove_dir_all(&dir);
+    Ok(())
+}
