+    /// Record routed demand and write it to `path` as a profile for `model_sha256` on drain.
+    pub(crate) fn with_profile_out(
+        mut self,
+        path: std::path::PathBuf,
+        model_sha256: String,
+    ) -> Self {
+        self.profile_out = Some((path, model_sha256));
+        self
+    }
+    fn write_profile(&self, state: &RuntimeState) -> Result<()> {
+        let Some((path, model_sha256)) = &self.profile_out else {
+            return Ok(());
+        };
+        let mut ranked: Vec<(&ExpertKey, &u64)> = state.demand.iter().collect();
+        ranked.sort_by(|a, b| b.1.cmp(a.1).then(a.0.cmp(b.0)));
+        let profile = serde_json::json!({
+            "schema": 1,
+            "model_sha256": model_sha256,
+            "layers": self.layers,
+            "experts_per_layer": self.experts,
+            "ranking": ranked
+                .iter()
+                .map(|(k, _)| serde_json::json!({"layer": k.layer, "expert": k.expert}))
+                .collect::<Vec<_>>(),
+        });
+        let counts = serde_json::json!({
+            "schema": "gnostral.expert-demand/1",
+            "model_sha256": model_sha256,
+            "forwards": state.forwards,
+            "routes": ranked
+                .iter()
+                .map(|(k, n)| serde_json::json!({"layer": k.layer, "expert": k.expert, "routes": n}))
+                .collect::<Vec<_>>(),
+        });
+        // Write then rename so a reader never sees a truncated profile.
+        let write = |p: &std::path::Path, v: &serde_json::Value| {
+            let tmp = p.with_extension("tmp");
+            std::fs::write(&tmp, v.to_string())
+                .and_then(|()| std::fs::rename(&tmp, p))
+                .map_err(|e| error(&format!("cannot write {}: {e}", p.display())))
+        };
+        write(path, &profile)?;
+        write(&path.with_extension("demand.json"), &counts)
+    }
