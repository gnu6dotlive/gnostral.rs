new file mode 100644
index 0000000..ed59909
--- /dev/null
+++ b/mistralrs/examples/gnostral_capture/main.rs
@@ -0,0 +1,141 @@
+//! Greedy token capture for the gnostral quality oracle (Q-030) and lane driver (Q-031).
+//!
+//! Run with:
+//! `cargo run --release --example gnostral_capture -p mistralrs --features gnostral-expert-residency -- \
+//!   --model-dir DIR --file MODEL.gguf --manifest PROMPTS.json --promptset-sha256 HASH \
+//!   --engine NAME --binary-sha256 HASH --model-sha256 HASH --max-tokens N --out CAPTURE.json [--cpu]`
+//!
+//! Writes a `gnostral.quality.capture/1` document (token ids of the greedy top-1 logprob at
+//! temperature 0) and prints one `GNOSTRAL_METRICS` line aggregated over every prompt.
+
+use anyhow::{bail, Context, Result};
+use mistralrs::{GgufModelBuilder, RequestBuilder, TextMessageRole};
+use serde_json::{json, Value};
+
+const CAPTURE_SCHEMA: &str = "gnostral.quality.capture/1";
+
+struct Args {
+    model_dir: String,
+    file: String,
+    manifest: String,
+    promptset_sha256: String,
+    engine: String,
+    binary_sha256: Option<String>,
+    model_sha256: Option<String>,
+    max_tokens: usize,
+    out: String,
+    cpu: bool,
+}
+
+fn parse() -> Result<Args> {
+    let mut map = std::collections::HashMap::new();
+    let mut cpu = false;
+    let mut it = std::env::args().skip(1);
+    while let Some(flag) = it.next() {
+        if flag == "--cpu" {
+            cpu = true;
+            continue;
+        }
+        let value = it.next().with_context(|| format!("{flag} needs a value"))?;
+        map.insert(flag, value);
+    }
+    let mut take = |k: &str| map.remove(k);
+    let need = |v: Option<String>, k: &str| v.with_context(|| format!("missing {k}"));
+    Ok(Args {
+        model_dir: need(take("--model-dir"), "--model-dir")?,
+        file: need(take("--file"), "--file")?,
+        manifest: need(take("--manifest"), "--manifest")?,
+        promptset_sha256: need(take("--promptset-sha256"), "--promptset-sha256")?,
+        engine: need(take("--engine"), "--engine")?,
+        binary_sha256: take("--binary-sha256"),
+        model_sha256: take("--model-sha256"),
+        max_tokens: need(take("--max-tokens"), "--max-tokens")?.parse()?,
+        out: need(take("--out"), "--out")?,
+        cpu,
+    })
+}
+
+#[tokio::main]
+async fn main() -> Result<()> {
+    let args = parse()?;
+    let manifest: Value = serde_json::from_str(&std::fs::read_to_string(&args.manifest)?)?;
+    let prompts = manifest["prompts"]
+        .as_array()
+        .context("manifest has no prompts")?;
+
+    let mut builder =
+        GgufModelBuilder::new(&args.model_dir, vec![args.file.clone()]).with_logging();
+    if args.cpu {
+        builder = builder.with_force_cpu();
+    }
+    let model = builder.build().await?;
+
+    let mut captures = Vec::new();
+    let (mut completion_tokens, mut completion_s) = (0usize, 0f64);
+    let (mut prompt_tokens, mut prompt_s) = (0usize, 0f64);
+    let mut ttft_ms = Vec::new();
+    for prompt in prompts {
+        let id = prompt["id"].as_str().context("prompt id")?;
+        let text = prompt["text"].as_str().context("prompt text")?;
+        let request = RequestBuilder::new()
+            .set_deterministic_sampler()
+            .set_sampler_max_len(args.max_tokens)
+            .return_logprobs(true)
+            .set_sampler_topn_logprobs(1)
+            .add_message(TextMessageRole::User, text);
+        let response = model.send_chat_request(request).await?;
+        let choice = response.choices.first().context("no choice")?;
+        let content = choice
+            .logprobs
+            .as_ref()
+            .and_then(|l| l.content.as_ref())
+            .context("engine returned no logprobs")?;
+        let mut ids = Vec::with_capacity(content.len());
+        for entry in content {
+            let Some(top) = entry.top_logprobs.first() else {
+                bail!("prompt {id}: a generated token has no top-1 logprob");
+            };
+            ids.push(top.token);
+        }
+        if ids.is_empty() {
+            bail!("prompt {id}: no tokens generated");
+        }
+        captures.push(json!({
+            "prompt_id": id,
+            "prompt_sha256": prompt["sha256"],
+            "token_ids": ids,
+        }));
+        let u = &response.usage;
+        completion_tokens += u.completion_tokens;
+        completion_s += f64::from(u.total_completion_time_sec);
+        prompt_tokens += u.prompt_tokens;
+        prompt_s += f64::from(u.total_prompt_time_sec);
+        ttft_ms.push(f64::from(u.total_prompt_time_sec) * 1e3);
+    }
+
+    let document = json!({
+        "schema": CAPTURE_SCHEMA,
+        "promptset_sha256": args.promptset_sha256,
+        "lane": {
+            "engine": args.engine,
+            "binary_sha256": args.binary_sha256,
+            "model_sha256": args.model_sha256,
+        },
+        "sampling": {"temperature": 0, "seed": 0, "max_tokens": args.max_tokens},
+        "captures": captures,
+    });
+    std::fs::write(&args.out, serde_json::to_string_pretty(&document)?)?;
+
+    let rate = |tokens: usize, secs: f64| (secs > 0.0).then(|| tokens as f64 / secs);
+    ttft_ms.sort_by(f64::total_cmp);
+    let median_ttft = ttft_ms.get(ttft_ms.len() / 2).copied();
+    println!(
+        "GNOSTRAL_METRICS {}",
+        json!({
+            "decode_tok_s": rate(completion_tokens, completion_s),
+            "prefill_tok_s": rate(prompt_tokens, prompt_s),
+            "ttft_ms": median_ttft,
+        })
+    );
+    Ok(())
+}
