diff --git a/mistralrs-core/src/gnostral_trace.rs b/mistralrs-core/src/gnostral_trace.rs
new file mode 100644
index 0000000..3341fa5
--- /dev/null
+++ b/mistralrs-core/src/gnostral_trace.rs
@@ -0,0 +1,137 @@
+//! Q-042 per-phase timers. Off unless built with `gnostral-trace` and run with `GNOSTRAL_TRACE=1`.
+
+pub(crate) use imp::*;
+
+#[cfg(feature = "gnostral-trace")]
+mod imp {
+    pub(crate) use gnostral_trace::Phase;
+    use gnostral_trace::{measure_overhead, Identity, MonotonicClock, Recorder, TRACE_ENV};
+    use std::sync::{Mutex, OnceLock};
+
+    const OUT_ENV: &str = "GNOSTRAL_TRACE_OUT";
+    const DEFAULT_OUT: &str = "gnostral-trace.json";
+    const BINARY_SHA_ENV: &str = "GNOSTRAL_TRACE_BINARY_SHA256";
+    const MODEL_SHA_ENV: &str = "GNOSTRAL_TRACE_MODEL_SHA256";
+    const SPAN_CAPACITY: usize = 1 << 18;
+    const OVERHEAD_SPANS: usize = 10_000;
+
+    struct State {
+        clock: &'static MonotonicClock,
+        rec: Recorder<'static>,
+        begun: bool,
+        done: bool,
+    }
+
+    static STATE: OnceLock<Option<Mutex<State>>> = OnceLock::new();
+
+    fn state() -> Option<&'static Mutex<State>> {
+        STATE
+            .get_or_init(|| {
+                if std::env::var(TRACE_ENV).ok().as_deref() != Some("1") {
+                    return None;
+                }
+                let clock: &'static MonotonicClock = Box::leak(Box::default());
+                Some(Mutex::new(State {
+                    clock,
+                    rec: Recorder::new(clock, true, SPAN_CAPACITY),
+                    begun: false,
+                    done: false,
+                }))
+            })
+            .as_ref()
+    }
+
+    #[inline]
+    pub(crate) fn start() -> Option<u64> {
+        let guard = state()?.lock().ok()?;
+        (guard.begun && !guard.done).then(|| guard.rec.start())
+    }
+
+    #[inline]
+    pub(crate) fn stop(phase: Phase, start: Option<u64>) {
+        let (Some(start), Some(state)) = (start, state()) else {
+            return;
+        };
+        if let Ok(mut guard) = state.lock() {
+            if !guard.done {
+                guard.rec.stop(phase, start);
+            }
+        }
+    }
+
+    /// Stop recording until [`reset`] (used around the engine's warmup dummy run).
+    pub(crate) fn pause() {
+        if let Some(Ok(mut guard)) = state().map(Mutex::lock) {
+            guard.done = true;
+        }
+    }
+
+    /// Forget everything recorded so far; the next busy period starts a fresh timeline.
+    pub(crate) fn reset() {
+        if let Some(Ok(mut guard)) = state().map(Mutex::lock) {
+            let clock = guard.clock;
+            guard.rec = Recorder::new(clock, true, SPAN_CAPACITY);
+            guard.begun = false;
+            guard.done = false;
+        }
+    }
+
+    /// Called once per engine loop iteration: the first busy iteration starts the timeline,
+    /// the first idle one after it ends the timeline and writes the receipt.
+    pub(crate) fn request_boundary(busy: bool) {
+        let Some(state) = state() else {
+            return;
+        };
+        let Ok(mut guard) = state.lock() else {
+            return;
+        };
+        if busy && !guard.begun {
+            guard.rec.begin_request();
+            guard.begun = true;
+        } else if !busy && guard.begun && !guard.done {
+            guard.rec.end_request();
+            guard.done = true;
+            let identity = Identity {
+                binary_sha256: std::env::var(BINARY_SHA_ENV).ok(),
+                model_sha256: std::env::var(MODEL_SHA_ENV).ok(),
+                command: std::env::args().collect::<Vec<_>>().join(" "),
+            };
+            let mut timeline = guard.rec.timeline(identity);
+            timeline.overhead_ns_per_span = Some(measure_overhead(guard.clock, OVERHEAD_SPANS));
+            let out = std::env::var(OUT_ENV).unwrap_or_else(|_| DEFAULT_OUT.to_string());
+            match std::fs::write(&out, timeline.to_json()) {
+                Ok(()) => tracing::info!("gnostral trace written to {out}\n{}", timeline.summary()),
+                Err(e) => tracing::error!("cannot write gnostral trace {out}: {e}"),
+            }
+        }
+    }
+}
+
+#[cfg(not(feature = "gnostral-trace"))]
+mod imp {
+    #[derive(Clone, Copy)]
+    pub(crate) enum Phase {
+        Schedule,
+        Forward,
+        #[cfg_attr(not(feature = "gnostral-expert-residency"), allow(dead_code))]
+        CpuExpert,
+        Sample,
+    }
+
+    #[inline(always)]
+    pub(crate) fn start() -> Option<u64> {
+        None
+    }
+
+    #[inline(always)]
+    pub(crate) fn stop(_phase: Phase, _start: Option<u64>) {}
+
+    #[inline(always)]
+    pub(crate) fn request_boundary(_busy: bool) {}
+
+    #[inline(always)]
+    pub(crate) fn pause() {}
+
+    #[inline(always)]
+    pub(crate) fn reset() {}
+}
