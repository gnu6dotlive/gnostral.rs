+/// The model's residency runtime when the environment requests one, else `None`.
+///
+/// `standard_experts` is the caller's statement that every layer carries routed GGUF expert stacks
+/// with no other quantization config; the model and its tensor names are otherwise generic.
+pub(crate) fn runtime_from_environment(
+    vb_m: &mistralrs_quant::ShardedVarBuilder,
+    real_device: &candle_core::Device,
+    loading_isq: bool,
+    standard_experts: bool,
+    layers: usize,
+    experts: usize,
+) -> Result<Option<std::sync::Arc<ExpertResidencyRuntime>>> {
+    use sha2::{Digest, Sha256};
+    let Some(request) = ExpertResidencyRequest::from_environment()? else {
+        return Ok(None);
+    };
+    let cpu_opt_in = std::env::var(CPU_RESIDENCY_ENV).is_ok_and(|v| v == "1");
+    if !(real_device.is_cuda() || (real_device.is_cpu() && cpu_opt_in))
+        || loading_isq
+        || !standard_experts
+    {
+        candle_core::bail!("native residency pilot requires unsharded CUDA (or GNOSTRAL_EXPERT_RESIDENCY_CPU=1 on CPU) GGUF with every layer using standard experts");
+    }
+    let source = vb_m
+        .weight_source()
+        .ok_or_else(|| error("native residency requires GGUF source identity"))?;
+    let bytes = source
+        .single_file_gguf_bytes()
+        .ok_or_else(|| error("native residency pilot requires a single-file GGUF source"))?;
+    let hash = format!("{:x}", Sha256::digest(bytes));
+    let layers = u32::try_from(layers).map_err(|_| error("layer count overflow"))?;
+    let experts = u32::try_from(experts).map_err(|_| error("expert count overflow"))?;
+    let mut runtime = ExpertResidencyRuntime::new(
+        request.validate(&hash, layers, experts)?,
+        layers,
+        experts,
+        real_device.clone(),
+    )?;
+    if let Some(path) = std::env::var_os(PROFILE_OUT_ENV) {
+        runtime = runtime.with_profile_out(path.into(), hash);
+    }
+    Ok(Some(std::sync::Arc::new(runtime)))
+}
