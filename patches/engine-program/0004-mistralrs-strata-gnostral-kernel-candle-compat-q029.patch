From 48be92c374ef044f12f165932f5434c1addf668a Mon Sep 17 00:00:00 2001
From: Jordan <dev.in@gnu6.live>
Date: Fri, 23 Oct 2026 23:48:03 +0000
Subject: [PATCH] feat(moe): gnostral CPU expert kernel bit-equal to candle via
 CandleCompat numerics (Q-029)

The gnostral lane now replays the float combination of the Candle k-quant
kernel this host dispatches to (AVX2+FMA lanes or vec_dot_unopt), so it is
bit-equal to the candle lane; the residency test asserts bit equality.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016D4Xz7aLLGu873oZNF6vk4
---
 mistralrs-core/src/moe/experts/residency.rs       | 12 ++++++++++--
 mistralrs-core/src/moe/experts/residency_tests.rs | 10 ++++------
 mistralrs-core/src/pipeline/mod.rs                |  5 ++++-
 3 files changed, 18 insertions(+), 9 deletions(-)

diff --git a/mistralrs-core/src/moe/experts/residency.rs b/mistralrs-core/src/moe/experts/residency.rs
index e4f59ed..1d4b6b2 100644
--- a/mistralrs-core/src/moe/experts/residency.rs
+++ b/mistralrs-core/src/moe/experts/residency.rs
@@ -991,7 +991,9 @@ fn gnostral_ffn_typed<
     hidden: usize,
     act: fn(f32) -> f32,
 ) -> Result<Vec<Vec<f32>>> {
-    use gnostral_cpu_kernels::{kquant::blocks_from_bytes, ExpertGroup, FfnShape, Isa, Pool, QK_K};
+    use gnostral_cpu_kernels::{
+        kquant::blocks_from_bytes, DotKernel, ExpertGroup, FfnShape, Isa, Numerics, Pool, QK_K,
+    };
     let (experts, inter, gate_hidden) = host.gate.shape().dims3()?;
     if gate_hidden != hidden || host.down.shape().dims() != [experts, hidden, inter] {
         candle_core::bail!("gnostral cpu kernel expert geometry mismatch");
@@ -1023,8 +1025,14 @@ fn gnostral_ffn_typed<
             rows: g.len,
         })
         .collect::<Vec<_>>();
+    // CandleCompat replays the float combination of the Candle kernel this host runs, so the lane is
+    // bit-equal to `candle` while the integer part uses the widest ISA available.
+    let kernel = DotKernel {
+        isa: Isa::detect(),
+        numerics: Numerics::CandleCompat,
+    };
     gnostral_cpu_kernels::grouped_expert_ffn(
-        Isa::detect(),
+        kernel,
         Pool::global(),
         FfnShape { hidden, inter },
         &ffn_groups,
