@@ -504,7 +504,7 @@ fn grouped_cpu_executor_is_bit_equal_to_per_route() -> candle_core::Result<()> {
 }
 
 #[test]
-fn gnostral_cpu_kernel_tracks_candle_within_tolerance() -> candle_core::Result<()> {
+fn gnostral_cpu_kernel_is_bit_equal_to_candle() -> candle_core::Result<()> {
     let tokens = 9;
     let xs = grouped_input(tokens)?;
     let routes = varied_routes(tokens, 4);
@@ -516,11 +516,9 @@ fn gnostral_cpu_kernel_tracks_candle_within_tolerance() -> candle_core::Result<(
     let got = gnostral
         .forward_with(0, &xs, &routes, |x| x.silu(), Some(silu))?
         .to_vec2::<f32>()?;
-    for (row_got, row_ref) in got.iter().zip(&reference) {
-        let scale = row_ref.iter().fold(0f32, |m, v| m.max(v.abs())).max(1e-6);
-        for (a, b) in row_got.iter().zip(row_ref) {
-            // Same Q8_K activations; only float reduction order differs (frozen in Q-029).
-            assert!((a - b).abs() <= 1e-3 * scale, "{a} vs {b}");
+    for (r, (row_got, row_ref)) in got.iter().zip(&reference).enumerate() {
+        for (c, (a, b)) in row_got.iter().zip(row_ref).enumerate() {
+            assert_eq!(a.to_bits(), b.to_bits(), "row {r} col {c}: {a} vs {b}");
         }
     }
     assert!(gnostral
