+
+    fn compute_per_route(
+        &self,
+        resident: &BTreeMap<ExpertKey, ExpertProjectionSet>,
+        host: &ExpertProjectionSet,
+        xs: &Tensor,
+        routes: &[Route],
+        activation: &impl Fn(&Tensor) -> Result<Tensor>,
+    ) -> Result<Tensor> {
+        let (tokens, hidden) = xs.dims2()?;
+        let mut ordered = routes.to_vec();
+        ordered.sort_by_key(|r| (r.token, r.ordinal));
+        let cpu = xs.to_dtype(DType::F32)?.to_device(&Device::Cpu)?;
+        let mut output = vec![
+            0f32;
+            tokens
+                .checked_mul(hidden)
+                .ok_or_else(|| error("output shape overflow"))?
+        ];
+        for route in ordered {
+            let row = cpu.narrow(0, route.token, 1)?;
+            let contribution = if let Some(weights) = resident.get(&route.key) {
+                weights
+                    .compute(&row.to_device(&self.device)?, activation)?
+                    .to_device(&Device::Cpu)?
+            } else {
+                host.slice_to(route.key.expert as usize, &Device::Cpu)?
+                    .compute(&row, activation)?
+            };
+            let values = contribution.to_vec2::<f32>()?;
+            for (dst, &value) in output[route.token * hidden..(route.token + 1) * hidden]
+                .iter_mut()
+                .zip(&values[0])
+            {
+                *dst += value * route.weight;
+            }
+        }
+        Tensor::from_vec(output, (tokens, hidden), xs.device())?.to_dtype(xs.dtype())
+    }
+
+    /// One plan per layer: GPU groups are enqueued first, host groups run while the device
+    /// works, a single sync collects the device results and the scatter-add follows the
+    /// per-route `(token, ordinal)` order.
+    fn compute_grouped(
+        &self,
+        resident: &BTreeMap<ExpertKey, ExpertProjectionSet>,
+        host: &ExpertProjectionSet,
+        xs: &Tensor,
+        routes: &[Route],
+        activation: &impl Fn(&Tensor) -> Result<Tensor>,
+        act_f32: Option<fn(f32) -> f32>,
+    ) -> Result<Tensor> {
+        let (tokens, hidden) = xs.dims2()?;
+        let flat = xs
+            .to_dtype(DType::F32)?
+            .to_device(&Device::Cpu)?
+            .flatten_all()?
+            .to_vec1::<f32>()?;
+        let exec_routes = routes
+            .iter()
+            .map(|r| {
+                Ok(exec::Route {
+                    token: u32::try_from(r.token).map_err(|_| error("route token overflow"))?,
+                    ordinal: u32::try_from(r.ordinal)
+                        .map_err(|_| error("route ordinal overflow"))?,
+                    key: exec::ExpertKey::new(r.key.layer, r.key.expert),
+                    weight: r.weight,
+                })
+            })
+            .collect::<Result<Vec<_>>>()?;
+        let plan = exec::plan(
+            &exec_routes,
+            |k| {
+                if resident.contains_key(&ExpertKey {
+                    layer: k.layer,
+                    expert: k.expert,
+                }) {
+                    exec::Placement::GpuResident
+                } else {
+                    exec::Placement::CpuHost
+                }
+            },
+            exec::PlanLimits {
+                token_count: u32::try_from(tokens).map_err(|_| error("token count overflow"))?,
+                max_group_routes: 0,
+            },
+        )
+        .map_err(plan_error)?;
+        let mut contributions = vec![Vec::new(); plan.groups().len()];
+
+        let mut device_parts = Vec::new();
+        let mut device_slots = Vec::new();
+        let mut host_groups = Vec::new();
+        for (slot, group) in plan.groups().iter().enumerate() {
+            let rows = exec::gather_group(&plan, group, &exec_routes, &flat, hidden)
+                .map_err(plan_error)?;
+            match group.placement {
+                exec::Placement::GpuResident => {
+                    let weights = &resident[&ExpertKey {
+                        layer: group.key.layer,
+                        expert: group.key.expert,
+                    }];
+                    let rows = Tensor::from_vec(rows, (group.len, hidden), &Device::Cpu)?
+                        .to_device(&self.device)?;
+                    let out = match self.executor.gpu_rows {
+                        GpuRows::Batched => weights.compute(&rows, activation)?,
+                        GpuRows::PerRow => {
+                            let parts = (0..group.len)
+                                .map(|i| weights.compute(&rows.narrow(0, i, 1)?, activation))
+                                .collect::<Result<Vec<_>>>()?;
+                            Tensor::cat(&parts, 0)?
+                        }
+                    };
+                    device_parts.push(out);
+                    device_slots.push((slot, group.len));
+                }
+                exec::Placement::CpuHost => host_groups.push(HostGroup {
+                    slot,
+                    expert: group.key.expert as usize,
+                    rows,
+                    len: group.len,
+                }),
+                exec::Placement::Upload => {
+                    return Err(plan_error(exec::PlanError::UploadGroupNotReady {
+                        layer: group.key.layer,
+                        expert: group.key.expert,
+                    }))
+                }
+            }
+        }
+
+        let gnostral = match (self.executor.cpu_kernel, act_f32) {
+            (CpuKernel::Gnostral, Some(act)) => Some(act),
+            (CpuKernel::Gnostral, None) => {
+                candle_core::bail!("{CPU_KERNEL_ENV}=gnostral requires a SiLU expert activation")
+            }
+            (CpuKernel::Candle, _) => None,
+        };
+        if let Some(act) = gnostral.filter(|_| !host_groups.is_empty()) {
+            let outputs = gnostral_host_ffn(host, &host_groups, hidden, act)?;
+            for (group, out) in host_groups.iter().zip(outputs) {
+                contributions[group.slot] = out;
+            }
+        } else {
+            for group in host_groups {
+                let rows = Tensor::from_vec(group.rows, (group.len, hidden), &Device::Cpu)?;
+                contributions[group.slot] = host
+                    .compute_host_group(group.expert, &rows, activation)?
+                    .flatten_all()?
+                    .to_vec1::<f32>()?;
+            }
+        }
+
+        if !device_parts.is_empty() {
+            let joined = Tensor::cat(&device_parts, 0)?
+                .to_device(&Device::Cpu)?
+                .to_dtype(DType::F32)?
+                .flatten_all()?
+                .to_vec1::<f32>()?;
+            let mut offset = 0;
+            for (slot, len) in device_slots {
+                contributions[slot] = joined[offset..offset + len * hidden].to_vec();
+                offset += len * hidden;
+            }
+        }
+
+        let output = exec::scatter_ordered(&plan, &exec_routes, &contributions, tokens, hidden)
+            .map_err(plan_error)?;
+        Tensor::from_vec(output, (tokens, hidden), xs.device())?.to_dtype(xs.dtype())
+    }
 }
 
 impl Drop for ExpertResidencyRuntime {
@@ -573,3 +878,83 @@ impl ExpertResidencyRequest {
         .ok_or_else(|| error("unexpected disabled expert residency request"))
     }
 }
+
+fn gnostral_host_ffn(
+    host: &ExpertProjectionSet,
+    groups: &[HostGroup],
+    hidden: usize,
+    act: fn(f32) -> f32,
+) -> Result<Vec<Vec<f32>>> {
+    use gnostral_cpu_kernels::{BlockQ2K, BlockQ3K};
+    if host.up.dtype() != host.gate.dtype() {
+        candle_core::bail!("gnostral cpu kernel needs gate and up in the same dtype");
+    }
+    match (host.gate.dtype(), host.down.dtype()) {
+        (GgmlDType::Q2K, GgmlDType::Q2K) => {
+            gnostral_ffn_typed::<BlockQ2K, BlockQ2K>(host, groups, hidden, act)
+        }
+        (GgmlDType::Q2K, GgmlDType::Q3K) => {
+            gnostral_ffn_typed::<BlockQ2K, BlockQ3K>(host, groups, hidden, act)
+        }
+        (GgmlDType::Q3K, GgmlDType::Q2K) => {
+            gnostral_ffn_typed::<BlockQ3K, BlockQ2K>(host, groups, hidden, act)
+        }
+        (GgmlDType::Q3K, GgmlDType::Q3K) => {
+            gnostral_ffn_typed::<BlockQ3K, BlockQ3K>(host, groups, hidden, act)
+        }
+        (gate, down) => candle_core::bail!(
+            "gnostral cpu kernel supports Q2K/Q3K experts, got gate {gate:?} down {down:?}"
+        ),
+    }
+}
+
+fn gnostral_ffn_typed<
+    G: gnostral_cpu_kernels::KQuantBlock,
+    D: gnostral_cpu_kernels::KQuantBlock,
+>(
+    host: &ExpertProjectionSet,
+    groups: &[HostGroup],
+    hidden: usize,
+    act: fn(f32) -> f32,
+) -> Result<Vec<Vec<f32>>> {
+    use gnostral_cpu_kernels::{kquant::blocks_from_bytes, ExpertGroup, FfnShape, Isa, Pool, QK_K};
+    let (experts, inter, gate_hidden) = host.gate.shape().dims3()?;
+    if gate_hidden != hidden || host.down.shape().dims() != [experts, hidden, inter] {
+        candle_core::bail!("gnostral cpu kernel expert geometry mismatch");
+    }
+    let (gate_bytes, up_bytes, down_bytes) =
+        (host.gate.data()?, host.up.data()?, host.down.data()?);
+    fn view<T: gnostral_cpu_kernels::KQuantBlock>(bytes: &[u8]) -> Result<&[T]> {
+        blocks_from_bytes::<T>(bytes)
+            .ok_or_else(|| error("expert stack is not a whole aligned block slice"))
+    }
+    let gate = view::<G>(&gate_bytes)?;
+    let up = view::<G>(&up_bytes)?;
+    let down = view::<D>(&down_bytes)?;
+    let per_gate = inter * hidden / QK_K;
+    let per_down = hidden * inter / QK_K;
+    if gate.len() != experts * per_gate
+        || up.len() != gate.len()
+        || down.len() != experts * per_down
+    {
+        candle_core::bail!("gnostral cpu kernel block count mismatch");
+    }
+    let ffn_groups = groups
+        .iter()
+        .map(|g| ExpertGroup {
+            gate: &gate[g.expert * per_gate..(g.expert + 1) * per_gate],
+            up: &up[g.expert * per_gate..(g.expert + 1) * per_gate],
+            down: &down[g.expert * per_down..(g.expert + 1) * per_down],
+            x: &g.rows,
+            rows: g.len,
+        })
+        .collect::<Vec<_>>();
+    gnostral_cpu_kernels::grouped_expert_ffn(
+        Isa::detect(),
+        Pool::global(),
+        FfnShape { hidden, inter },
+        &ffn_groups,
+        act,
+    )
+    .map_err(kernel_error)
+}
