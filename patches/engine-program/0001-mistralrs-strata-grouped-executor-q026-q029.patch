+pub(crate) const EXECUTOR_ENV: &str = "GNOSTRAL_MOE_EXECUTOR";
+pub(crate) const CPU_KERNEL_ENV: &str = "GNOSTRAL_CPU_EXPERT_KERNEL";
+pub(crate) const GPU_ROWS_ENV: &str = "GNOSTRAL_MOE_GPU_ROWS";
+
+/// Per-route loop (the Q-009/Q-010 path) or one plan per layer with grouped execution.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum ExecutorMode {
+    PerRoute,
+    Grouped,
+}
+
+/// Which CPU kernel computes host expert groups.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum CpuKernel {
+    /// Candle k_quants on the borrowed expert slice; bit-equal to the per-route path.
+    Candle,
+    /// gnostral-cpu-kernels grouped Q8_K x Q2_K/Q3_K FFN; tolerance-equal, not bit-equal.
+    Gnostral,
+}
+
+/// How resident (GPU) groups are dispatched.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum GpuRows {
+    /// One m=1 kernel per row, as the per-route path: same numerics, no per-route sync.
+    PerRow,
+    /// One kernel over the whole group; different CUDA kernel family for m > 1.
+    Batched,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct ExecutorConfig {
+    pub mode: ExecutorMode,
+    pub cpu_kernel: CpuKernel,
+    pub gpu_rows: GpuRows,
+}
+
+impl Default for ExecutorConfig {
+    fn default() -> Self {
+        Self {
+            mode: ExecutorMode::Grouped,
+            cpu_kernel: CpuKernel::Candle,
+            gpu_rows: GpuRows::PerRow,
+        }
+    }
+}
+
+impl ExecutorConfig {
+    pub(crate) fn from_environment() -> Result<Self> {
+        let read = |name: &str| match std::env::var(name) {
+            Ok(value) => Ok(Some(value)),
+            Err(std::env::VarError::NotPresent) => Ok(None),
+            Err(e) => Err(error(&format!("invalid {name}: {e}"))),
+        };
+        Self::from_values(
+            read(EXECUTOR_ENV)?.as_deref(),
+            read(CPU_KERNEL_ENV)?.as_deref(),
+            read(GPU_ROWS_ENV)?.as_deref(),
+        )
+    }
+
+    pub(crate) fn from_values(
+        mode: Option<&str>,
+        cpu_kernel: Option<&str>,
+        gpu_rows: Option<&str>,
+    ) -> Result<Self> {
+        let config = Self {
+            mode: match mode {
+                None | Some("grouped") => ExecutorMode::Grouped,
+                Some("per-route") => ExecutorMode::PerRoute,
+                Some(other) => {
+                    candle_core::bail!("{EXECUTOR_ENV} must be grouped or per-route, got {other:?}")
+                }
+            },
+            cpu_kernel: match cpu_kernel {
+                None | Some("candle") => CpuKernel::Candle,
+                Some("gnostral") => CpuKernel::Gnostral,
+                Some(other) => {
+                    candle_core::bail!("{CPU_KERNEL_ENV} must be candle or gnostral, got {other:?}")
+                }
+            },
+            gpu_rows: match gpu_rows {
+                None | Some("per-row") => GpuRows::PerRow,
+                Some("batched") => GpuRows::Batched,
+                Some(other) => {
+                    candle_core::bail!("{GPU_ROWS_ENV} must be per-row or batched, got {other:?}")
+                }
+            },
+        };
+        if config.mode == ExecutorMode::PerRoute
+            && (config.cpu_kernel != CpuKernel::Candle || config.gpu_rows != GpuRows::PerRow)
+        {
+            candle_core::bail!("{CPU_KERNEL_ENV} and {GPU_ROWS_ENV} require the grouped executor");
+        }
+        Ok(config)
+    }
+}
+
+/// Repacked x86 kernels may change per-row numerics with m, so these dtypes run m=1 per row.
+fn batch_rows_bit_stable(dtype: GgmlDType) -> bool {
+    !matches!(dtype, GgmlDType::Q4K | GgmlDType::Q6K | GgmlDType::Q8_0)
+        && !cfg!(target_arch = "aarch64")
+}
+
+fn plan_error(e: exec::PlanError) -> candle_core::Error {
+    candle_core::Error::Msg(e.to_string())
+}
+
+fn kernel_error(e: gnostral_cpu_kernels::KernelError) -> candle_core::Error {
+    candle_core::Error::Msg(format!("gnostral cpu expert kernel: {e:?}"))
+}
+
+/// One host expert group handed to the gnostral grouped FFN.
+struct HostGroup {
+    slot: usize,
+    expert: usize,
+    rows: Vec<f32>,
+    len: usize,
+}
+
 #[derive(Clone)]
 pub(super) struct ExpertProjectionSet {
     pub gate: Arc<QTensor>,
@@ -123,6 +243,26 @@ impl ExpertProjectionSet {
         let up = QMatMul::from_arc(self.up.clone())?.forward(xs)?;
         QMatMul::from_arc(self.down.clone())?.forward(&(activation(&gate)? * up)?)
     }
+    /// One expert over `rows` (`[m, hidden]` F32 on CPU), slicing the expert once per group.
+    fn compute_host_group(
+        &self,
+        expert: usize,
+        rows: &Tensor,
+        activation: &impl Fn(&Tensor) -> Result<Tensor>,
+    ) -> Result<Tensor> {
+        let weights = self.slice_to(expert, &Device::Cpu)?;
+        if self
+            .tensors()
+            .iter()
+            .all(|q| batch_rows_bit_stable(q.dtype()))
+        {
+            return weights.compute(rows, activation);
+        }
+        let parts = (0..rows.dim(0)?)
+            .map(|i| weights.compute(&rows.narrow(0, i, 1)?, activation))
+            .collect::<Result<Vec<_>>>()?;
+        Tensor::cat(&parts, 0)
+    }
     fn padded_bytes(&self, experts: u32) -> Result<u64> {
         let mut bytes = 0u64;
         for q in self.tensors() {
