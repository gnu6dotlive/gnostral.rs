@@ -382,3 +382,170 @@ fn mixed_cpu_cuda_layer_admission_never_uploads_cpu_only_experts() -> candle_cor
     assert_eq!(runtime.snapshot()?.gpu_allocated_bytes, Some(0));
     Ok(())
