+
+use super::residency::{CpuKernel, ExecutorConfig, ExecutorMode, GpuRows};
+
+const GROUPED_HIDDEN: usize = 512;
+const GROUPED_INTER: usize = 256;
+const GROUPED_EXPERTS: usize = 6;
+
+struct Lcg(u64);
+impl Lcg {
+    fn next(&mut self) -> u64 {
+        self.0 = self
+            .0
+            .wrapping_mul(6364136223846793005)
+            .wrapping_add(1442695040888963407);
+        self.0 >> 48
+    }
+    fn unit(&mut self) -> f32 {
+        let bits = u16::try_from(self.next()).expect("16-bit draw");
+        f32::from(bits) / f32::from(u16::MAX) * 2.0 - 1.0
+    }
+}
+
+fn lcg_values(seed: u64, n: usize, scale: f32) -> Vec<f32> {
+    let mut rng = Lcg(seed);
+    (0..n).map(|_| rng.unit() * scale).collect()
+}
+
+fn varied_projections() -> candle_core::Result<ExpertProjectionSet> {
+    let (e, h, i) = (GROUPED_EXPERTS, GROUPED_HIDDEN, GROUPED_INTER);
+    let q = |seed, shape: (usize, usize, usize), dtype| -> candle_core::Result<Arc<QTensor>> {
+        let n = shape.0 * shape.1 * shape.2;
+        Ok(Arc::new(QTensor::quantize(
+            &Tensor::from_vec(lcg_values(seed, n, 0.05), shape, &Device::Cpu)?,
+            dtype,
+        )?))
+    };
+    Ok(ExpertProjectionSet {
+        gate: q(1, (e, i, h), GgmlDType::Q2K)?,
+        up: q(2, (e, i, h), GgmlDType::Q2K)?,
+        down: q(3, (e, h, i), GgmlDType::Q3K)?,
+    })
+}
+
+fn varied_routes(tokens: usize, top_k: usize) -> Vec<Route> {
+    let mut rng = Lcg(7);
+    let experts = u64::try_from(GROUPED_EXPERTS).expect("small");
+    let mut routes = Vec::new();
+    for token in 0..tokens {
+        let mut used = Vec::new();
+        for ordinal in 0..top_k {
+            let mut expert = u32::try_from(rng.next() % experts).expect("small");
+            while used.contains(&expert) {
+                expert = (expert + 1) % u32::try_from(experts).expect("small");
+            }
+            used.push(expert);
+            routes.push(Route {
+                token,
+                ordinal,
+                key: ExpertKey { layer: 0, expert },
+                weight: 0.1 + rng.unit().abs() / 3.0,
+            });
+        }
+    }
+    routes
+}
+
+fn cpu_runtime(executor: ExecutorConfig) -> candle_core::Result<ExpertResidencyRuntime> {
+    let mut runtime = ExpertResidencyRuntime::new(
+        ExpertResidencyConfig {
+            budget_bytes: 0,
+            profile: vec![],
+        },
+        1,
+        u32::try_from(GROUPED_EXPERTS).expect("small"),
+        Device::Cpu,
+    )?;
+    runtime.set_executor(executor);
+    runtime.register(0, varied_projections()?)?;
+    runtime.finish_loading()?;
+    Ok(runtime)
+}
+
+fn executor(mode: ExecutorMode, cpu_kernel: CpuKernel) -> ExecutorConfig {
+    ExecutorConfig {
+        mode,
+        cpu_kernel,
+        gpu_rows: GpuRows::PerRow,
+    }
+}
+
+fn grouped_input(tokens: usize) -> candle_core::Result<Tensor> {
+    Tensor::from_vec(
+        lcg_values(11, tokens * GROUPED_HIDDEN, 2.0),
+        (tokens, GROUPED_HIDDEN),
+        &Device::Cpu,
+    )
+}
+
+#[test]
+fn grouped_cpu_executor_is_bit_equal_to_per_route() -> candle_core::Result<()> {
+    let tokens = 9;
+    let xs = grouped_input(tokens)?;
+    let routes = varied_routes(tokens, 4);
+    let per_route = cpu_runtime(executor(ExecutorMode::PerRoute, CpuKernel::Candle))?
+        .forward(0, &xs, &routes, |x| x.silu())?
+        .to_vec2::<f32>()?;
+    let grouped = cpu_runtime(executor(ExecutorMode::Grouped, CpuKernel::Candle))?;
+    let mut shuffled = routes.clone();
+    shuffled.reverse();
+    shuffled.swap(1, 7);
+    for order in [&routes, &shuffled] {
+        let got = grouped
+            .forward(0, &xs, order, |x| x.silu())?
+            .to_vec2::<f32>()?;
+        for (a, b) in got.iter().flatten().zip(per_route.iter().flatten()) {
+            assert_eq!(a.to_bits(), b.to_bits());
+        }
+    }
+    Ok(())
+}
+
+#[test]
+fn gnostral_cpu_kernel_tracks_candle_within_tolerance() -> candle_core::Result<()> {
+    let tokens = 9;
+    let xs = grouped_input(tokens)?;
+    let routes = varied_routes(tokens, 4);
+    let reference = cpu_runtime(executor(ExecutorMode::PerRoute, CpuKernel::Candle))?
+        .forward(0, &xs, &routes, |x| x.silu())?
+        .to_vec2::<f32>()?;
+    let gnostral = cpu_runtime(executor(ExecutorMode::Grouped, CpuKernel::Gnostral))?;
+    let silu: fn(f32) -> f32 = gnostral_cpu_kernels::silu;
+    let got = gnostral
+        .forward_with(0, &xs, &routes, |x| x.silu(), Some(silu))?
+        .to_vec2::<f32>()?;
+    for (row_got, row_ref) in got.iter().zip(&reference) {
+        let scale = row_ref.iter().fold(0f32, |m, v| m.max(v.abs())).max(1e-6);
+        for (a, b) in row_got.iter().zip(row_ref) {
+            // Same Q8_K activations; only float reduction order differs (frozen in Q-029).
+            assert!((a - b).abs() <= 1e-3 * scale, "{a} vs {b}");
+        }
+    }
+    assert!(gnostral
+        .forward_with(0, &xs, &routes, |x| x.silu(), None)
+        .is_err());
+    Ok(())
+}
+
+#[test]
+fn executor_configuration_is_explicit() -> candle_core::Result<()> {
+    let default = ExecutorConfig::from_values(None, None, None)?;
+    assert_eq!(default, executor(ExecutorMode::Grouped, CpuKernel::Candle));
+    assert_eq!(
+        ExecutorConfig::from_values(Some("per-route"), None, None)?.mode,
+        ExecutorMode::PerRoute
+    );
+    assert_eq!(
+        ExecutorConfig::from_values(None, Some("gnostral"), Some("batched"))?,
+        ExecutorConfig {
+            mode: ExecutorMode::Grouped,
+            cpu_kernel: CpuKernel::Gnostral,
+            gpu_rows: GpuRows::Batched,
+        }
+    );
+    assert!(ExecutorConfig::from_values(Some("fast"), None, None).is_err());
+    assert!(ExecutorConfig::from_values(Some("per-route"), Some("gnostral"), None).is_err());
+    Ok(())
+}
