diff --git a/mistralrs-core/src/utils/gguf_metadata.rs b/mistralrs-core/src/utils/gguf_metadata.rs
index 6d26e2d..8446279 100644
--- a/mistralrs-core/src/utils/gguf_metadata.rs
+++ b/mistralrs-core/src/utils/gguf_metadata.rs
@@ -247,6 +247,18 @@ pub struct GgufDeviceMapLoaderInner<'a, 'f> {
     pub arch: GGUFArchitecture,
 }
 
+impl GgufDeviceMapLoaderInner<'_, '_> {
+    /// Expert cache bytes when Qwen3 MoE expert residency is requested, else 0.
+    fn residency_cache_bytes(&self) -> usize {
+        #[cfg(feature = "gnostral-expert-residency")]
+        if let GGUFArchitecture::Qwen3MoE = self.arch {
+            return crate::moe::requested_cache_bytes()
+                .map_or(0, |b| usize::try_from(b).unwrap_or(usize::MAX));
+        }
+        0
+    }
+}
+
 impl DeviceMappedModelLoader for GgufDeviceMapLoaderInner<'_, '_> {
     fn mapped_max_act_size_elems(
         &self,
@@ -344,7 +356,7 @@ impl DeviceMappedModelLoader for GgufDeviceMapLoaderInner<'_, '_> {
                 } else {
                     tensor_info_size_in_bytes!(self.model.tensor_info("output.weight")?)
                 };
-                token_embd + output_norm + output
+                token_embd + output_norm + output + self.residency_cache_bytes()
             }
             GGUFArchitecture::Starcoder2 => {
                 let token_embd = tensor_info_size_in_bytes!(
@@ -529,7 +541,12 @@ impl DeviceMappedModelLoader for GgufDeviceMapLoaderInner<'_, '_> {
                     .model
                     .tensor_info("blk.0.attn_output.weight")?);
 
-                let ffn_gate = if let GGUFArchitecture::Qwen3MoE = self.arch {
+                // Under expert residency the stacks load host-side; only the cache budget (counted
+                // once in the non-mapped size) lives on the device.
+                let residency = self.residency_cache_bytes() > 0;
+                let ffn_gate = if residency {
+                    0
+                } else if let GGUFArchitecture::Qwen3MoE = self.arch {
                     tensor_info_size_in_bytes!(self
                         .model
                         .tensor_info("blk.0.ffn_gate_exps.weight")?)
@@ -537,7 +554,9 @@ impl DeviceMappedModelLoader for GgufDeviceMapLoaderInner<'_, '_> {
                     tensor_info_size_in_bytes!(self.model.tensor_info("blk.0.ffn_gate.weight")?)
                 };
 
-                let ffn_up = if let GGUFArchitecture::Qwen3MoE = self.arch {
+                let ffn_up = if residency {
+                    0
+                } else if let GGUFArchitecture::Qwen3MoE = self.arch {
                     tensor_info_size_in_bytes!(self
                         .model
                         .tensor_info("blk.0.ffn_up_exps.weight")?)
@@ -545,7 +564,9 @@ impl DeviceMappedModelLoader for GgufDeviceMapLoaderInner<'_, '_> {
                     tensor_info_size_in_bytes!(self.model.tensor_info("blk.0.ffn_up.weight")?)
                 };
 
-                let ffn_down = if let GGUFArchitecture::Qwen3MoE = self.arch {
+                let ffn_down = if residency {
+                    0
+                } else if let GGUFArchitecture::Qwen3MoE = self.arch {
                     tensor_info_size_in_bytes!(self
                         .model
                         .tensor_info("blk.0.ffn_down_exps.weight")?)
@@ -655,3 +676,92 @@ impl DeviceMappedModelLoader for GgufDeviceMapLoaderInner<'_, '_> {
         Ok(Box::new(model_config_metadata))
     }
 }
