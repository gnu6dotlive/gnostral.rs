+#[cfg(all(test, feature = "gnostral-expert-residency"))]
+mod residency_sizing_tests {
+    use super::*;
+
+    const CACHE_ENV: &str = "GNOSTRAL_EXPERT_CACHE_BYTES";
+
+    // Generated by the repository's synthetic Qwen3-MoE writer; skipped only where the generator is absent.
+    fn synthetic_gguf(dir: &std::path::Path) -> Option<std::path::PathBuf> {
+        let maker = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+            .join("../../../harness/synthetic-moe/make_qwen3moe_gguf.py");
+        if !maker.exists() {
+            return None;
+        }
+        let out = dir.join("synth.gguf");
+        let ok = std::process::Command::new("python3")
+            .arg("-I")
+            .arg(&maker)
+            .args([
+                "--out",
+                out.to_str()?,
+                "--layers",
+                "2",
+                "--experts",
+                "4",
+                "--top-k",
+                "2",
+            ])
+            .output()
+            .ok()?
+            .status
+            .success();
+        ok.then_some(out)
+    }
+
+    #[test]
+    fn residency_moves_expert_stacks_out_of_mapped_layers() -> Result<()> {
+        let dir = std::env::temp_dir().join(format!("gnostral-sizing-{}", std::process::id()));
+        fs::create_dir_all(&dir)?;
+        let Some(path) = synthetic_gguf(&dir) else {
+            eprintln!("synthetic GGUF generator not found; sizing test skipped");
+            return Ok(());
+        };
+        let mut file = fs::File::open(&path)?;
+        let mut readers = [&mut file];
+        let content = Content::from_readers(&mut readers)?;
+        let loader = GgufDeviceMapLoaderInner {
+            model: &content,
+            arch: GGUFArchitecture::Qwen3MoE,
+        };
+        let sizes = |l: &GgufDeviceMapLoaderInner<'_, '_>| -> Result<(Vec<usize>, usize)> {
+            Ok((
+                l.layer_sizes_in_bytes("", DType::F32, 1, None)?,
+                l.non_mapped_size_in_bytes("", DType::F32, 1, None, None)?,
+            ))
+        };
+        // SAFETY of env mutation: no other test in this crate reads this variable.
+        std::env::remove_var(CACHE_ENV);
+        let (dense_layers, dense_rest) = sizes(&loader)?;
+        std::env::set_var(CACHE_ENV, "4096");
+        let resident = sizes(&loader);
+        std::env::remove_var(CACHE_ENV);
+        let (res_layers, res_rest) = resident?;
+
+        let stacks: usize = ["gate", "up", "down"]
+            .iter()
+            .map(|p| {
+                content
+                    .tensor_info(&format!("blk.0.ffn_{p}_exps.weight"))
+                    .map(|t| tensor_info_size_in_bytes!(t))
+            })
+            .sum::<candle_core::Result<usize>>()?;
+        assert!(stacks > 0);
+        for (d, r) in dense_layers.iter().zip(&res_layers) {
+            assert_eq!(
+                d - r,
+                stacks,
+                "every mapped layer drops exactly its expert stacks"
+            );
+        }
+        assert_eq!(
+            res_rest,
+            dense_rest + 4096,
+            "the cache budget is reserved once"
+        );
+        fs::remove_dir_all(&dir).ok();
+        Ok(())
+    }
+}
