+++ b/mistralrs-core/src/moe/experts/residency.rs
@@ -905,6 +905,18 @@ impl Drop for ExpertResidencyRuntime {
     }
 }
 
+/// Bytes of the expert cache requested through the environment, without reading the profile.
+///
+/// `Some` whenever residency would be active: expert stacks then load host-side and only this many
+/// bytes of experts live on the device, so device mapping must not count the stacks per layer.
+pub(crate) fn requested_cache_bytes() -> Option<u64> {
+    let budget = std::env::var("GNOSTRAL_EXPERT_CACHE_BYTES").ok()?;
+    if budget.is_empty() || !budget.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    budget.parse::<u64>().ok().filter(|&b| b > 0)
+}
+
 pub(crate) struct ExpertResidencyRequest {
     budget: String,
     profile: String,
