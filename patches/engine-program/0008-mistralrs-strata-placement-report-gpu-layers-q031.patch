+#[cfg(all(test, feature = "gnostral-trace"))]
+mod placement_tests {
+    use super::*;
+    use crate::device_map::{DeviceLayerMapMetadata, DeviceMapMetadata, DeviceMapSetting};
+    use candle_core::Device;
+
+    #[test]
+    fn canonical_placement_compresses_runs() {
+        let l = |v: &[&str]| v.iter().map(|s| s.to_string()).collect::<Vec<_>>();
+        assert_eq!(
+            canonical_placement(&l(&["cuda:0", "cuda:0", "cpu", "cpu", "cpu"]), "cuda:0"),
+            "0-1:cuda:0,2-4:cpu;nm=cuda:0"
+        );
+        assert_eq!(canonical_placement(&l(&["cpu"]), "cpu"), "0-0:cpu;nm=cpu");
+        assert_eq!(canonical_placement(&[], "cpu"), ";nm=cpu");
+    }
+
+    #[test]
+    fn into_mapper_reports_the_placement_it_built() -> candle_core::Result<()> {
+        let dir = std::env::temp_dir().join(format!("gnostral-placement-{}", std::process::id()));
+        std::fs::create_dir_all(&dir)?;
+        let out = dir.join("placement.json");
+        // No other test in this crate reads this variable.
+        std::env::set_var("GNOSTRAL_PLACEMENT_OUT", &out);
+        let setting = DeviceMapSetting::Map(DeviceMapMetadata::from_num_device_layers(vec![
+            DeviceLayerMapMetadata {
+                ordinal: 0,
+                layers: 3,
+            },
+        ]));
+        let built = setting.into_mapper(5, &Device::Cpu, None, &[Device::Cpu]);
+        std::env::remove_var("GNOSTRAL_PLACEMENT_OUT");
+        built?;
+        let doc: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(&out)?)
+            .map_err(candle_core::Error::wrap)?;
+        assert_eq!(doc["schema"], "gnostral.placement/1");
+        assert_eq!(doc["layers"].as_array().map(Vec::len), Some(5));
+        assert_eq!(doc["canonical"], "0-4:cpu;nm=cpu");
+        std::fs::remove_dir_all(&dir).ok();
+        Ok(())
+    }
 }
