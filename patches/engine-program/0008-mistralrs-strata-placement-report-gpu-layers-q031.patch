+#[cfg(all(test, feature = "gnostral-expert-residency"))]
+mod native_residency_sizing_tests {
+    use super::*;
+    use crate::pipeline::loaders::{AutoDeviceMapQuantization, Qwen3MoELoader};
+    use crate::NormalLoaderType;
+    use candle_core::DType;
+    use mistralrs_quant::QuantizedWeightSource;
+
+    const CACHE_ENV: &str = "GNOSTRAL_EXPERT_CACHE_BYTES";
+
+    fn synthetic_gguf(dir: &Path) -> Option<PathBuf> {
+        let maker = Path::new(env!("CARGO_MANIFEST_DIR"))
+            .join("../../../harness/synthetic-moe/make_qwen3moe_gguf.py");
+        if !maker.exists() {
+            return None;
+        }
+        let out = dir.join("synth.gguf");
+        let status = std::process::Command::new("python3")
+            .arg("-I")
+            .arg(&maker)
+            .args([
+                "--out",
+                out.to_str()?,
+                "--layers",
+                "3",
+                "--experts",
+                "8",
+                "--top-k",
+                "2",
+            ])
+            .output()
+            .ok()?
+            .status;
+        status.success().then_some(out)
+    }
+
+    // Walks the steps `load_native_normal` and the normal pipeline take for a GGUF loaded with
+    // GgufModelBuilder (archive, descriptor, adapter, synthesized config, GGUF weight source,
+    // pack factor), then sizes layers exactly as the automatic device map does.
+    #[test]
+    fn native_gguf_device_map_sizing_drops_host_loaded_experts() -> Result<()> {
+        let dir = env::temp_dir().join(format!("gnostral-native-sizing-{}", std::process::id()));
+        fs::create_dir_all(&dir)?;
+        let Some(path) = synthetic_gguf(&dir) else {
+            eprintln!("synthetic GGUF generator not found; native sizing test skipped");
+            return Ok(());
+        };
+        let archive = Arc::new(mistralrs_quant::GgufArchive::open([&path])?);
+        let tensor_names = archive.tensors().keys().cloned().collect::<Vec<_>>();
+        let metadata_keys = archive
+            .metadata()
+            .keys()
+            .map(String::as_str)
+            .collect::<Vec<_>>();
+        let tensor_refs = tensor_names.iter().map(String::as_str).collect::<Vec<_>>();
+        let descriptor = GgufDescriptor::new("qwen3moe", &metadata_keys, &tensor_refs)?;
+        let resolved = resolve_native_adapter(&descriptor, None)?;
+        assert_eq!(resolved.adapter.loader, NormalLoaderType::Qwen3Moe);
+        let rope_pairing =
+            crate::gguf::normal_registry::schema_for(descriptor.architecture).rope_pairing;
+        let config =
+            synthesize_normal_config(&resolved.adapter.loader, archive.metadata(), &tensor_names)?;
+        let config = stamp_qk_rope_layout(&config, rope_pairing)?;
+        let bindings =
+            build_normal_bindings(&archive, &resolved.adapter.loader, descriptor.architecture)?;
+        let dtype = DType::F32;
+        let source = mistralrs_quant::GgufWeightSource::new(archive.clone(), &bindings, dtype)?;
+        let quantization = AutoDeviceMapQuantization::weight_source_with_topology(&source, None);
+        let pack = quantization.conservative_pack_factor(dtype, source.pack_factor(dtype)?);
+
+        let loader = Qwen3MoELoader;
+        let sizes = || -> Result<(Vec<usize>, usize)> {
+            Ok((
+                loader.layer_sizes_in_bytes(&config, dtype, pack, None)?,
+                loader.non_mapped_size_in_bytes(&config, dtype, pack, Some(&quantization), None)?,
+            ))
+        };
+        // No other test in this crate reads this variable.
+        env::remove_var(CACHE_ENV);
+        let (dense, dense_rest) = sizes()?;
+        env::set_var(CACHE_ENV, "4096");
+        let resident = sizes();
+        env::remove_var(CACHE_ENV);
+        let (res, res_rest) = resident?;
+
+        let cfg: serde_json::Value = serde_json::from_str(&config)?;
+        let (h, i, e) = (
+            cfg["hidden_size"].as_u64().unwrap() as usize,
+            cfg["moe_intermediate_size"].as_u64().unwrap() as usize,
+            cfg["num_experts"].as_u64().unwrap() as usize,
+        );
+        let stacks = e * 3 * (h * i / pack) * dtype.size_in_bytes();
+        assert_eq!(dense.len(), 3);
+        for (d, r) in dense.iter().zip(&res) {
+            assert_eq!(
+                d - r,
+                stacks,
+                "each mapped layer drops exactly its expert stacks"
+            );
+        }
+        assert_eq!(res_rest, dense_rest + 4096);
+        fs::remove_dir_all(&dir).ok();
+        Ok(())
+    }
+}
