diff --git a/mistralrs-core/src/gnostral_trace.rs b/mistralrs-core/src/gnostral_trace.rs
index 3341fa5..4f0f95b 100644
--- a/mistralrs-core/src/gnostral_trace.rs
+++ b/mistralrs-core/src/gnostral_trace.rs
@@ -105,6 +105,64 @@ mod imp {
             }
         }
     }
+
+    const PLACEMENT_ENV: &str = "GNOSTRAL_PLACEMENT_OUT";
+
+    fn device_name(device: &candle_core::Device) -> String {
+        match device.location() {
+            candle_core::DeviceLocation::Cpu => "cpu".to_string(),
+            candle_core::DeviceLocation::Cuda { gpu_id } => format!("cuda:{gpu_id}"),
+            candle_core::DeviceLocation::Metal { gpu_id } => format!("metal:{gpu_id}"),
+        }
+    }
+
+    /// `0-15:cuda:0,16-47:cpu;nm=cuda:0`: per-layer devices as ranges, then the non-mapped device.
+    pub(crate) fn canonical_placement(layers: &[String], non_mapped: &str) -> String {
+        let mut ranges = Vec::new();
+        let mut start = 0;
+        for i in 1..=layers.len() {
+            if i == layers.len() || layers[i] != layers[start] {
+                ranges.push(format!("{start}-{}:{}", i - 1, layers[start]));
+                start = i;
+            }
+        }
+        format!("{};nm={non_mapped}", ranges.join(","))
+    }
+
+    /// Write the layer placement the mapper decided when `GNOSTRAL_PLACEMENT_OUT` is set.
+    ///
+    /// The engine's own report, not a parse of its logs: benchmark lanes pin it as identity. A later
+    /// mapper built in the same process overwrites the file, so the last load wins.
+    pub(crate) fn report_placement(
+        model_layers: usize,
+        non_mapped: &candle_core::Device,
+        mapper: &dyn crate::device_map::DeviceMapper,
+    ) {
+        let Some(out) = std::env::var_os(PLACEMENT_ENV) else {
+            return;
+        };
+        let layers: Vec<String> = (0..model_layers)
+            .map(|i| {
+                mapper
+                    .device_for(i, false)
+                    .map_or_else(|| "unmapped".to_string(), device_name)
+            })
+            .collect();
+        let nm = device_name(non_mapped);
+        let doc = serde_json::json!({
+            "schema": "gnostral.placement/1",
+            "layers": layers,
+            "non_mapped": nm,
+            "canonical": canonical_placement(&layers, &nm),
+        });
+        let path = std::path::PathBuf::from(out);
+        let tmp = path.with_extension("tmp");
+        let written =
+            std::fs::write(&tmp, doc.to_string()).and_then(|()| std::fs::rename(&tmp, &path));
+        if let Err(e) = written {
+            tracing::error!("cannot write placement report {}: {e}", path.display());
+        }
+    }
 }
 
